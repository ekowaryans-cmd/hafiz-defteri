{"s":70,"ad":"Mearic","ayetler":[{"v":1,"cuz":29,"sayfa":568,"ar":"سَاَلَ سَٓائِلٌ بِعَذَابٍ وَاقِعٍۙ","ok":"Se ele sailun bi azabin vakı'n.","k":[["سَأَلَ","seele"],["سَآئِلٌۢ","sailun"],["بِعَذَابٍۢ","biazabin"],["وَاقِعٍۢ","vakiin"]]},{"v":2,"cuz":29,"sayfa":568,"ar":"لِلْـكَافِر۪ينَ لَيْسَ لَهُ دَافِعٌۙ","ok":"Lil kafirine leyse lehu dafi'.","k":[["لِّلْكَـٰفِرِينَ","lilkafirine"],["لَيْسَ","leyse"],["لَهُۥ","lehu"],["دَافِعٌۭ","dafiun"]]},{"v":3,"cuz":29,"sayfa":568,"ar":"مِنَ اللّٰهِ ذِي الْمَعَارِجِۜ","ok":"Minallahi zil mearic.","k":[["مِّنَ","mine"],["ٱللَّهِ","llahi"],["ذِى","zi"],["ٱلْمَعَارِجِ","l-meaarici"]]},{"v":4,"cuz":29,"sayfa":568,"ar":"تَعْرُجُ الْمَلٰٓئِكَةُ وَالرُّوحُ اِلَيْهِ ف۪ي يَوْمٍ كَانَ مِقْدَارُهُ خَمْس۪ينَ اَلْفَ سَنَةٍۚ","ok":"Ta'rucul melaiketu ver ruhu ileyhi fi yevmin kane mikdaruhu hamsine elfe seneh.","k":[["تَعْرُجُ","tea'rucu"],["ٱلْمَلَـٰٓئِكَةُ","l-melaiketu"],["وَٱلرُّوحُ","ve rruhu"],["إِلَيْهِ","ileyhi"],["فِى","fi"],["يَوْمٍۢ","yevmin"],["كَانَ","kane"],["مِقْدَارُهُۥ","mikdaruhu"],["خَمْسِينَ","hamsine"],["أَلْفَ","elfe"],["سَنَةٍۢ","senetin"]]},{"v":5,"cuz":29,"sayfa":568,"ar":"فَاصْبِرْ صَبْراً جَم۪يلاً","ok":"Fasbir sabren cemila.","k":[["فَٱصْبِرْ","fesbir"],["صَبْرًۭا","sabran"],["جَمِيلًا","cemilen"]]},{"v":6,"cuz":29,"sayfa":568,"ar":"اِنَّهُمْ يَرَوْنَهُ بَع۪يداًۙ","ok":"İnnehum yerevnehu baida.","k":[["إِنَّهُمْ","innehum"],["يَرَوْنَهُۥ","yeravnehu"],["بَعِيدًۭا","beiyden"]]},{"v":7,"cuz":29,"sayfa":568,"ar":"وَنَرٰيهُ قَر۪يباًۜ","ok":"Ve nerahu kariba.","k":[["وَنَرَىٰهُ","venerahu"],["قَرِيبًۭا","kariben"]]},{"v":8,"cuz":29,"sayfa":568,"ar":"يَوْمَ تَكُونُ السَّمَٓاءُ كَالْمُهْلِۙ","ok":"Yevme tekunus semau kel muhl.","k":[["يَوْمَ","yevme"],["تَكُونُ","tekunu"],["ٱلسَّمَآءُ","s-semau"],["كَٱلْمُهْلِ","kalmuhli"]]},{"v":9,"cuz":29,"sayfa":568,"ar":"وَتَكُونُ الْجِبَالُ كَالْعِهْنِۙ","ok":"Ve tekunul cibalu kel ıhn.","k":[["وَتَكُونُ","ve tekunu"],["ٱلْجِبَالُ","l-cibalu"],["كَٱلْعِهْنِ","kal'ihni"]]},{"v":10