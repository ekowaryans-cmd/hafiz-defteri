{"s":87,"ad":"Ala","ayetler":[{"v":1,"cuz":30,"sayfa":591,"ar":"سَبِّحِ اسْمَ رَبِّكَ الْاَعْلٰىۙ","ok":"Sebbihısme rabbikel a'la.","k":[["سَبِّحِ","sebbihi"],["ٱسْمَ","isme"],["رَبِّكَ","rabbike"],["ٱلْأَعْلَى","l-ea'la"]]},{"v":2,"cuz":30,"sayfa":591,"ar":"اَلَّذ۪ي خَلَقَ فَسَوّٰىۙۖ","ok":"Ellezi halaka fesevva.","k":[["ٱلَّذِى","ellezi"],["خَلَقَ","haleka"],["فَسَوَّىٰ","fesevva"]]},{"v":3,"cuz":30,"sayfa":591,"ar":"وَالَّذ۪ي قَدَّرَ فَهَدٰىۙۖ","ok":"Vellezi kaddere fe heda.","k":[["وَٱلَّذِى","vellezi"],["قَدَّرَ","kaddera"],["فَهَدَىٰ","feheda"]]},{"v":4,"cuz":30,"sayfa":591,"ar":"وَالَّـذ۪ٓي اَخْرَجَ الْمَرْعٰىۙۖ","ok":"Vellezi ahrecel mer'a.","k":[["وَٱلَّذِىٓ","vellezi"],["أَخْرَجَ","ehrace"],["ٱلْمَرْعَىٰ","l-mer'aa"]]},{"v":5,"cuz":30,"sayfa":591,"ar":"فَجَعَلَهُ غُثَٓاءً اَحْوٰىۜ","ok":"Fe cealehu gusaen ahva.","k":[["فَجَعَلَهُۥ","fe cealehu"],["غُثَآءً","gusa'en"],["أَحْوَىٰ","ehva"]]},{"v":6,"cuz":30,"sayfa":591,"ar":"سَنُقْرِئُكَ فَلَا تَنْسٰىۙ","ok":"Senukriuke fe la tensa.","k":[["سَنُقْرِئُكَ","senukriuke"],["فَلَا","fela"],["تَنسَىٰٓ","tensa"]]},{"v":7,"cuz":30,"sayfa":591,"ar":"اِلَّا مَا شَٓاءَ اللّٰهُۜ  اِنَّهُ يَعْلَمُ الْجَهْرَ وَمَا يَخْفٰىۜ","ok":"İlla ma şaallah, innehu ya'lemul cehre ve ma yahfa.","k":[["إِلَّا","illa"],["مَا","ma"],["شَآءَ","şa'e"],["ٱللَّهُ ۚ","llahu"],["إِنَّهُۥ","innehu"],["يَعْلَمُ","yea'lemu"],["ٱلْجَهْرَ","l-cehra"],["وَمَا","ve ma"],["يَخْفَىٰ","yehfa"]]},{"v":8,"cuz":30,"sayfa":591,"ar":"وَنُيَسِّرُكَ لِلْيُسْرٰىۚ","ok":"Ve nuyessiruke lil yusra.","k":[["وَنُيَسِّرُكَ","ve nuyessiruke"],["لِلْيُسْرَىٰ","lilyusra"]]},{"v":9,"cuz":30,"sayfa":591,"ar":"فَذَكِّرْ اِنْ نَفَعَتِ الذِّكْرٰىۜ","ok":"Fe zekkir in nefeatiz zikra.","k":[["فَذَكِّرْ","fezekkir"],["إِن","in"],["نَّفَعَتِ","nefeati"],["ٱلذِّكْرَىٰ","z-zikra"]]},{"v":10,"cuz":30,"sayfa":591,"ar":"سَيَذَّكَّرُ مَنْ يَخْشٰىۙ","ok":"Seyezzekkeru men yahşa.","k":[["سَيَذَّكَّرُ","seyezzekkeru"],["مَن","men"],["يَخْشَىٰ","yehşa"]]},{"v":11,"cuz":30,"sayfa":591,"ar":"وَيَتَجَنَّبُهَا الْاَشْقٰىۙ","ok":"Ve yetecennebuhel eşka.","k":[["وَيَتَجَنَّبُهَا","ve yetecennebuha"],["ٱلْأَشْقَى","l-eşka"]]},{"v":12,"cuz":30,"sayfa":591,"ar":"اَلَّذ۪ي يَصْلَى النَّارَ الْـكُبْرٰىۚ","ok":"Ellezi yaslen narel kubra.","k":[["ٱلَّذِى","ellezi"],["يَصْلَى","yesla"],["ٱلنَّارَ","n-nara"],["ٱلْكُبْرَىٰ","l-kubra"]]},{"v":13,"cuz":30,"sayfa":591,"ar":"ثُمَّ لَا يَمُوتُ ف۪يهَا وَلَا يَحْيٰىۜ","ok":"Summe la yemutu fiha ve la yahya.","k":[["ثُمَّ","summe"],["لَا","la"],["يَمُوتُ","yemutu"],["فِيهَا","fiha"],["وَلَا","ve la"],["يَحْيَىٰ","yehya"]]},{"v":14,"cuz":30,"sayfa":591,"ar":"قَدْ اَفْلَحَ مَنْ تَزَكّٰىۙ","ok":"Kad efleha men tezekka.","k":[["قَدْ","kad"],["أَفْلَحَ","efleha"],["مَن","men"],["تَزَكَّىٰ","tezekka"]]},{"v":15,"cuz":30,"sayfa":591,"ar":"وَذَكَرَ اسْمَ رَبِّه۪ فَصَلّٰىۜ","ok":"Ve zekeresme rabbihi fe salla.","k":[["وَذَكَرَ","ve zekera"],["ٱسْمَ","isme"],["رَبِّهِۦ","rabbihi"],["فَصَلَّىٰ","fe salla"]]},{"v":16,"cuz":30,"sayfa":592,"ar":"بَلْ تُؤْثِرُونَ الْحَيٰوةَ الدُّنْيَاۘ","ok":"Bel tu'sırunel hayated dunya.","k":[["بَلْ","bel"],["تُؤْثِرُونَ","tu'sirune"],["ٱلْحَيَوٰةَ","l-hayate"],["ٱلدُّنْيَا","d-dunya"]]},{"v":17,"cuz":30,"sayfa":592,"ar":"وَالْاٰخِرَةُ خَيْرٌ وَاَبْـقٰىۜ","ok":"Vel ahıretu hayrun ve ebka.","k":[["وَٱلْـَٔاخِرَةُ","vel'ahiratu"],["خَيْرٌۭ","hayrun"],["وَأَبْقَىٰٓ","ve ebka"]]},{"v":18,"cuz":30,"sayfa":592,"ar":"اِنَّ هٰذَا لَفِي الصُّحُفِ الْاُو۫لٰىۙ","ok":"İnne haza le fis suhufil ula.","k":[["إِنَّ","inne"],["هَـٰذَا","haza"],["لَفِى","lefi"],["ٱلصُّحُفِ","s-suhufi"],["ٱلْأُولَىٰ","l-ula"]]},{"v":19,"cuz":30,"sayfa":592,"ar":"صُحُفِ اِبْرٰه۪يمَ وَمُوسٰى","ok":"Suhufi ibrahime ve musa.","k":[["صُحُفِ","suhufi"],["إِبْرَٰهِيمَ","ibrahime"],["وَمُوسَىٰ","ve musa"]]}]}