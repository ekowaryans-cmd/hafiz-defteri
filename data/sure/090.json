{"s":90,"ad":"Beled","ayetler":[{"v":1,"cuz":30,"sayfa":594,"ar":"لَٓا اُقْسِمُ بِهٰذَا الْبَلَدِۙ","ok":"La uksimu bi hazel beled.","k":[["لَآ","la"],["أُقْسِمُ","uksimu"],["بِهَـٰذَا","bihaza"],["ٱلْبَلَدِ","l-beledi"]]},{"v":2,"cuz":30,"sayfa":594,"ar":"وَاَنْتَ حِلٌّ بِهٰذَا الْبَلَدِۙ","ok":"Ve ente hıllun bi hazel beled.","k":[["وَأَنتَ","ve ente"],["حِلٌّۢ","hillun"],["بِهَـٰذَا","bihaza"],["ٱلْبَلَدِ","l-beledi"]]},{"v":3,"cuz":30,"sayfa":594,"ar":"وَوَالِدٍ وَمَا وَلَدَۙ","ok":"Ve validin ve ma veled.","k":[["وَوَالِدٍۢ","ve validin"],["وَمَا","ve ma"],["وَلَدَ","velede"]]},{"v":4,"cuz":30,"sayfa":594,"ar":"لَقَدْ خَلَقْنَا الْاِنْسَانَ ف۪ي كَبَدٍۜ","ok":"Lekad halaknel insane fi kebed.","k":[["لَقَدْ","lekad"],["خَلَقْنَا","halekna"],["ٱلْإِنسَـٰنَ","l-insane"],["فِى","fi"],["كَبَدٍ","kebedin"]]},{"v":5,"cuz":30,"sayfa":594,"ar":"اَيَحْسَبُ اَنْ لَنْ يَقْدِرَ عَلَيْهِ اَحَدٌۢ","ok":"E yahsebu en len yakdira aleyhi ehad.","k":[["أَيَحْسَبُ","eyehsebu"],["أَن","en"],["لَّن","len"],["يَقْدِرَ","yekdira"],["عَلَيْهِ","aleyhi"],["أَحَدٌۭ","ehadun"]]},{"v":6,"cuz":30,"sayfa":594,"ar":"يَقُولُ اَهْلَكْتُ مَالاً لُبَداًۜ","ok":"Yekulu ehlektu malen lubeda.","k":[["يَقُولُ","yekulu"],["أَهْلَكْتُ","ehlektu"],["مَالًۭا","malen"],["لُّبَدًا","lubeden"]]},{"v":7,"cuz":30,"sayfa":594,"ar":"اَيَحْسَبُ اَنْ لَمْ يَرَهُٓ  اَحَدٌۜ","ok":"E yahsebu en lem yerahu ehad.","k":[["أَيَحْسَبُ","eyehsebu"],["أَن","en"],["لَّمْ","lem"],["يَرَهُۥٓ","yerahu"],["أَحَدٌ","ehadun"]]},{"v":8,"cuz":30,"sayfa":594,"ar":"اَلَمْ نَجْعَلْ لَهُ عَيْنَيْنِۙ","ok":"E lem nec'al lehu ayneyn.","k":[["أَلَمْ","elem"],["نَجْعَل","nec'al"],["لَّهُۥ","lehu"],["عَيْنَيْنِ","ayneyni"]]},{"v":9,"cuz":30,"sayfa":594,"ar":"وَلِسَاناً وَشَفَتَيْنِۙ","ok":"Ve lisanen ve şefeteyn.","k":[["وَلِسَانًۭا","velisanen"],["وَشَفَتَيْنِ","ve şefeteyni"]]},{"v":10,"cuz":30,"sayfa":594,"ar":"وَهَدَيْنَاهُ النَّجْدَيْنِۚ","ok":"Ve hedeynahun necdeyn.","k":[["وَهَدَيْنَـٰهُ","ve hedeynahu"],["ٱلنَّجْدَيْنِ","n-necdeyni"