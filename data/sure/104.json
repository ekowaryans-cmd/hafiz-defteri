{"s":104,"ad":"Hümeze","ayetler":[{"v":1,"cuz":30,"sayfa":601,"ar":"وَيْلٌ لِكُلِّ هُمَزَةٍ لُمَزَةٍۨۙ","ok":"Veylun li kulli humezetin lumezeh.","k":[["وَيْلٌۭ","veylun"],["لِّكُلِّ","likulli"],["هُمَزَةٍۢ","humezetin"],["لُّمَزَةٍ","lumezetin"]]},{"v":2,"cuz":30,"sayfa":601,"ar":"اَلَّذ۪ي جَمَعَ مَالاً وَعَدَّدَهُۙ","ok":"Ellezi cemea malen ve addedeh.","k":[["ٱلَّذِى","ellezi"],["جَمَعَ","cemea"],["مَالًۭا","malen"],["وَعَدَّدَهُۥ","ve addedehu"]]},{"v":3,"cuz":30,"sayfa":601,"ar":"يَحْسَبُ اَنَّ مَالَهُٓ اَخْلَدَهُۚ","ok":"Yahsebu enne malehu ahledeh.","k":[["يَحْسَبُ","yehsebu"],["أَنَّ","enne"],["مَالَهُۥٓ","malehu"],["أَخْلَدَهُۥ","ehledehu"]]},{"v":4,"cuz":30,"sayfa":601,"ar":"كَلَّا لَيُنْبَذَنَّ فِي الْحُطَمَةِۘ","ok":"Kella le yunbezenne fil hutameh.","k":[["كَلَّا ۖ","kella"],["لَيُنۢبَذَنَّ","leyunbezenne"],["فِى","fi"],["ٱلْحُطَمَةِ","l-hutameti"]]},{"v":5,"cuz":30,"sayfa":601,"ar":"وَمَٓا اَدْرٰيكَ مَا الْحُطَمَةُۜ","ok":"Ve ma edrake mel hutameh.","k":[["وَمَآ","ve ma"],["أَدْرَىٰكَ","edrake"],["مَا","ma"],["ٱلْحُطَمَةُ","l-hutametu"]]},{"v":6,"cuz":30,"sayfa":601,"ar":"نَارُ اللّٰهِ الْمُوقَدَةُۙ","ok":"Narullahil mukadeh.","k":[["نَارُ","naru"],["ٱللَّهِ","llahi"],["ٱلْمُوقَدَةُ","l-mukadetu"]]},{"v":7,"cuz":30,"sayfa":601,"ar":"اَلَّت۪ي تَطَّلِعُ عَلَى الْاَفْـِٔدَةِۜ","ok":"Elleti tettaliu alel ef'ideh.","k":[["ٱلَّتِى","elleti"],["تَطَّلِعُ","tettaliu"],["عَلَى","ala"],["ٱلْأَفْـِٔدَةِ","l-ef'ideti"]]},{"v":8,"cuz":30,"sayfa":601,"ar":"اِنَّهَا عَلَيْهِمْ مُؤْصَدَةٌۙ","ok":"İnneha aleyhim mu'sadeh.","k":[["إِنَّهَا","inneha"],["عَلَيْهِم","aleyhim"],["مُّؤْصَدَةٌۭ","mu'sadetun"]]},{"v":9,"cuz":30,"sayfa":601,"ar":"ف۪ي عَمَدٍ مُمَدَّدَةٍ","ok":"Fi amedin mumeddedeh.","k":[["فِى","fi"],["عَمَدٍۢ","amedin"],["مُّمَدَّدَةٍۭ","mumeddedetin"]]}]}