{"s":109,"ad":"Kafirun","ayetler":[{"v":1,"cuz":30,"sayfa":603,"ar":"قُلْ يَٓا اَيُّهَا الْـكَافِرُونَۙ","ok":"Kul ya eyyuhel kafirun.","k":[["قُلْ","kul"],["يَـٰٓأَيُّهَا","ya eyyuha"],["ٱلْكَـٰفِرُونَ","l-kafirune"]]},{"v":2,"cuz":30,"sayfa":603,"ar":"لَٓا اَعْبُدُ مَا تَعْبُدُونَۙ","ok":"La a'budu ma ta'budun.","k":[["لَآ","la"],["أَعْبُدُ","ea'budu"],["مَا","ma"],["تَعْبُدُونَ","tea'budune"]]},{"v":3,"cuz":30,"sayfa":603,"ar":"وَلَٓا اَنْتُمْ عَابِدُونَ مَٓا اَعْبُدُۚ","ok":"Ve la entum abidune ma a'bud.","k":[["وَلَآ","ve la"],["أَنتُمْ","entum"],["عَـٰبِدُونَ","aabidune"],["مَآ","ma"],["أَعْبُدُ","ea'budu"]]},{"v":4,"cuz":30,"sayfa":603,"ar":"وَلَٓا اَنَا۬ عَابِدٌ مَا عَبَدْتُمْۙ","ok":"Ve la ene abidun ma abedtum.","k":[["وَلَآ","ve la"],["أَنَا۠","ena"],["عَابِدٌۭ","aabidun"],["مَّا","ma"],["عَبَدتُّمْ","abedtum"]]},{"v":5,"cuz":30,"sayfa":603,"ar":"وَلَٓا اَنْتُمْ عَابِدُونَ مَٓا اَعْبُدُۜ","ok":"Ve la entum abidune ma a'bud.","k":[["وَلَآ","ve la"],["أَنتُمْ","entum"],["عَـٰبِدُونَ","aabidune"],["مَآ","ma"],["أَعْبُدُ","ea'budu"]]},{"v":6,"cuz":30,"sayfa":603,"ar":"لَـكُمْ د۪ينُكُمْ وَلِيَ د۪ينِ","ok":"Lekum dinukum ve liye din.","k":[["لَكُمْ","lekum"],["دِينُكُمْ","dinukum"],["وَلِىَ","veliye"],["دِينِ","dini"]]}]}