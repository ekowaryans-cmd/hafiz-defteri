{"s":1,"ad":"Fatiha","ayetler":[{"v":1,"cuz":1,"sayfa":1,"ar":"بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّح۪يمِ","ok":"Bismillahir rahmanir rahim.","k":[["بِسْمِ","bismi"],["ٱللَّهِ","llahi"],["ٱلرَّحْمَـٰنِ","r-rahmani"],["ٱلرَّحِيمِ","r-rahimi"]]},{"v":2,"cuz":1,"sayfa":1,"ar":"اَلْحَمْدُ لِلّٰهِ رَبِّ الْعَالَم۪ينَۙ","ok":"El hamdu lillahi rabbil alemin .","k":[["ٱلْحَمْدُ","el-hamdu"],["لِلَّهِ","lillahi"],["رَبِّ","rabbi"],["ٱلْعَـٰلَمِينَ","l-aalemine"]]},{"v":3,"cuz":1,"sayfa":1,"ar":"اَلرَّحْمٰنِ الرَّح۪يمِۙ","ok":"Er rahmanir rahim.","k":[["ٱلرَّحْمَـٰنِ","er-rahmani"],["ٱلرَّحِيمِ","r-rahimi"]]},{"v":4,"cuz":1,"sayfa":1,"ar":"مَالِكِ يَوْمِ الدّ۪ينِۜ","ok":"Maliki yevmid din.","k":[["مَـٰلِكِ","maliki"],["يَوْمِ","yevmi"],["ٱلدِّينِ","d-dini"]]},{"v":5,"cuz":1,"sayfa":1,"ar":"اِيَّاكَ نَعْبُدُ وَاِيَّاكَ نَسْتَع۪ينُۜ","ok":"İyyake na'budu ve iyyake nestain.","k":[["إِيَّاكَ","iyyake"],["نَعْبُدُ","na'budu"],["وَإِيَّاكَ","ve iyyake"],["نَسْتَعِينُ","nesteiynu"]]},{"v":6,"cuz":1,"sayfa":1,"ar":"اِهْدِنَا الصِّرَاطَ الْمُسْتَق۪يمَۙ","ok":"İhdinas sıratel mustakim.","k":[["ٱهْدِنَا","ihdina"],["ٱلصِّرَٰطَ","s-sirata"],["ٱلْمُسْتَقِيمَ","l-mustekime"]]},{"v":7,"cuz":1,"sayfa":1,"ar":"صِرَاطَ الَّذ۪ينَ اَنْعَمْتَ عَلَيْهِمْۙ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّٓالّ۪ينَ","ok":"Sıratallezine en'amte aleyhim gayril magdubi aleyhim ve lad dallin.","k":[["صِرَٰطَ","sirata"],["ٱلَّذِينَ","ellezine"],["أَنْعَمْتَ","en'amte"],["عَلَيْهِمْ","aleyhim"],["غَيْرِ","gayri"],["ٱلْمَغْضُوبِ","l-megdubi"],["عَلَيْهِمْ","aleyhim"],["وَلَا","ve la"],["ٱلضَّآلِّينَ","d-dalline"]]}]}