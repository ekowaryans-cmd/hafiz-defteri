{"s":92,"ad":"Leyl","ayetler":[{"v":1,"cuz":30,"sayfa":595,"ar":"وَالَّيْلِ اِذَا يَغْشٰىۙ","ok":"Vel leyli iza yagşa.","k":[["وَٱلَّيْلِ","velleyli"],["إِذَا","iza"],["يَغْشَىٰ","yegşa"]]},{"v":2,"cuz":30,"sayfa":595,"ar":"وَالنَّهَارِ اِذَا تَجَلّٰىۙ","ok":"Ven nehari iza tecella.","k":[["وَٱلنَّهَارِ","ve nnehari"],["إِذَا","iza"],["تَجَلَّىٰ","tecella"]]},{"v":3,"cuz":30,"sayfa":595,"ar":"وَمَا خَلَقَ الذَّكَرَ وَالْاُنْثٰىۙ","ok":"Ve ma halakaz zekera vel unsa.","k":[["وَمَا","ve ma"],["خَلَقَ","haleka"],["ٱلذَّكَرَ","z-zekera"],["وَٱلْأُنثَىٰٓ","vel'unsa"]]},{"v":4,"cuz":30,"sayfa":595,"ar":"اِنَّ سَعْيَكُمْ لَشَتّٰىۜ","ok":"İnne sa'yekum le şetta.","k":[["إِنَّ","inne"],["سَعْيَكُمْ","sea'yekum"],["لَشَتَّىٰ","leşetta"]]},{"v":5,"cuz":30,"sayfa":595,"ar":"فَاَمَّا مَنْ اَعْطٰى وَاتَّقٰىۙ","ok":"Fe emma men a'ta vetteka.","k":[["فَأَمَّا","feemma"],["مَنْ","men"],["أَعْطَىٰ","ea'ta"],["وَٱتَّقَىٰ","vetteka"]]},{"v":6,"cuz":30,"sayfa":595,"ar":"وَصَدَّقَ بِالْحُسْنٰىۙ","ok":"Ve saddeka bil husna.","k":[["وَصَدَّقَ","ve saddeka"],["بِٱلْحُسْنَىٰ","bil-husna"]]},{"v":7,"cuz":30,"sayfa":595,"ar":"فَسَنُيَسِّرُهُ لِلْيُسْرٰىۜ","ok":"Fe senuyessiruhu lil yusra.","k":[["فَسَنُيَسِّرُهُۥ","fesenuyessiruhu"],["لِلْيُسْرَىٰ","lilyusra"]]},{"v":8,"cuz":30,"sayfa":595,"ar":"وَاَمَّا مَنْ بَخِلَ وَاسْتَغْنٰىۙ","ok":"Ve emma men bahıle vestagna.","k":[["وَأَمَّا","veemma"],["مَنۢ","men"],["بَخِلَ","behile"],["وَٱسْتَغْنَىٰ","vestegna"]]},{"v":9,"cuz":30,"sayfa":595,"ar":"وَكَذَّبَ بِالْحُسْنٰىۙ","ok":"Ve kezzebe bil husna.","k":[["وَكَذَّبَ","ve kezzebe"],["بِٱلْحُسْنَىٰ","bil-husna"]]},{"v":10,"cuz":30,"sayfa":595,"ar":"فَسَنُيَسِّرُهُ لِلْعُسْرٰىۜ","ok":"Fe senuyessiruhu lil usra.","k":[["فَسَنُيَسِّرُهُۥ","fesenuyessiruhu"],["لِلْعُسْرَىٰ","lil'usra"]]},{"v":11,"cuz":30,"sayfa":595,"ar":"وَمَا يُغْن۪ي عَنْهُ مَالُـهُٓ اِذَا تَرَدّٰىۜ","ok":"Ve ma yugni anhu maluhu iza teredda.","k":[["وَمَا","ve ma"],["يُغْنِى","yugni"],["عَنْهُ","anhu"],["مَالُهُۥٓ","maluhu"],["إِذَا","iza"],["تَرَدَّىٰٓ","teradda"]]},{"v":12,"cuz":30,"sayfa":595,"ar":"اِنَّ عَلَيْنَا لَلْهُدٰىۘ","ok":"İnne aleyna lel huda.","k":[["إِنَّ","inne"],["عَلَيْنَا","aleyna"],["لَلْهُدَىٰ","lelhuda"]]},{"v":13,"cuz":30,"sayfa":595,"ar":"وَاِنَّ لَنَا لَلْاٰخِرَةَ وَالْاُو۫لٰى","ok":"Ve inne lena lel ahırete vel ula.","k":[["وَإِنَّ","ve inne"],["لَنَا","lena"],["لَلْـَٔاخِرَةَ","lelahirate"],["وَٱلْأُولَىٰ","velula"]]},{"v":14,"cuz":30,"sayfa":595,"ar":"فَاَنْذَرْتُكُمْ نَاراً تَلَظّٰىۚ","ok":"Fe enzertukum naren telezza.","k":[["فَأَنذَرْتُكُمْ","feenzertukum"],["نَارًۭا","naran"],["تَلَظَّىٰ","telezza"]]},{"v":15,"cuz":30,"sayfa":596,"ar":"لَا يَصْلٰيهَٓا اِلَّا الْاَشْقٰىۙ","ok":"La yaslaha illel eşka.","k":[["لَا","la"],["يَصْلَىٰهَآ","yeslaha"],["إِلَّا","illa"],["ٱلْأَشْقَى","l-eşka"]]},{"v":16,"cuz":30,"sayfa":596,"ar":"اَلَّذ۪ي كَذَّبَ وَتَوَلّٰىۜ","ok":"Ellezi kezzebe ve tevella.","k":[["ٱلَّذِى","ellezi"],["كَذَّبَ","kezzebe"],["وَتَوَلَّىٰ","ve tevella"]]},{"v":17,"cuz":30,"sayfa":596,"ar":"وَسَيُجَنَّبُهَا الْاَتْقٰىۙ","ok":"Ve seyucennebuhel etka.","k":[["وَسَيُجَنَّبُهَا","veseyucennebuha"],["ٱلْأَتْقَى","l-etka"]]},{"v":18,"cuz":30,"sayfa":596,"ar":"اَلَّذ۪ي يُؤْت۪ي مَالَهُ يَتَزَكّٰىۚ","ok":"Ellezi yu'ti ma lehu yetezekka.","k":[["ٱلَّذِى","ellezi"],["يُؤْتِى","yu'ti"],["مَالَهُۥ","malehu"],["يَتَزَكَّىٰ","yetezekka"]]},{"v":19,"cuz":30,"sayfa":596,"ar":"وَمَا لِاَحَدٍ عِنْدَهُ مِنْ نِعْمَةٍ تُجْزٰىۙ","ok":"Ve ma li ehadin indehu min ni'metin tucza.","k":[["وَمَا","ve ma"],["لِأَحَدٍ","liehadin"],["عِندَهُۥ","indehu"],["مِن","min"],["نِّعْمَةٍۢ","nia'metin"],["تُجْزَىٰٓ","tucza"]]},{"v":20,"cuz":30,"sayfa":596,"ar":"اِلَّا ابْتِغَٓاءَ وَجْهِ رَبِّهِ الْاَعْلٰىۚ","ok":"İllebtigae vechi rabbihil a'la.","k":[["إِلَّا","illa"],["ٱبْتِغَآءَ","btiga'e"],["وَجْهِ","vechi"],["رَبِّهِ","rabbihi"],["ٱلْأَعْلَىٰ","l-ea'la"]]},{"v":21,"cuz":30,"sayfa":596,"ar":"وَلَسَوْفَ يَرْضٰى","ok":"Ve le sevfe yerda.","k":[["وَلَسَوْفَ","velesevfe"],["يَرْضَىٰ","yerda"]]}]}