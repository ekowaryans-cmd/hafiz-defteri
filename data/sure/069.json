{"s":69,"ad":"Hâkka","ayetler":[{"v":1,"cuz":29,"sayfa":566,"ar":"اَلْحَٓاقَّةُۙ","ok":"El hakkah.","k":[["ٱلْحَآقَّةُ","el-hakkatu"]]},{"v":2,"cuz":29,"sayfa":566,"ar":"مَا الْحَٓاقَّةُۚ","ok":"Mel hakkah.","k":[["مَا","ma"],["ٱلْحَآقَّةُ","l-hakkatu"]]},{"v":3,"cuz":29,"sayfa":566,"ar":"وَمَٓا اَدْرٰيكَ مَا الْحَٓاقَّةُۜ","ok":"Ve ma edrake mel hakkah.","k":[["وَمَآ","ve ma"],["أَدْرَىٰكَ","edrake"],["مَا","ma"],["ٱلْحَآقَّةُ","l-hakkatu"]]},{"v":4,"cuz":29,"sayfa":566,"ar":"كَذَّبَتْ ثَمُودُ وَعَادٌ بِالْقَارِعَةِ","ok":"Kezzebet semudu ve adun bil kariah.","k":[["كَذَّبَتْ","kezzebet"],["ثَمُودُ","semudu"],["وَعَادٌۢ","ve aadun"],["بِٱلْقَارِعَةِ","bil-kariati"]]},{"v":5,"cuz":29,"sayfa":566,"ar":"فَاَمَّا ثَمُودُ فَاُهْلِكُوا بِالطَّاغِيَةِ","ok":"Fe emma semudu fe uhliku bit tagıyeh.","k":[["فَأَمَّا","feemma"],["ثَمُودُ","semudu"],["فَأُهْلِكُوا۟","feuhliku"],["بِٱلطَّاغِيَةِ","bit-tagiyeti"]]},{"v":6,"cuz":29,"sayfa":566,"ar":"وَاَمَّا عَادٌ فَاُهْلِكُوا بِر۪يحٍ صَرْصَرٍ عَاتِيَةٍۙ","ok":"Ve emma adun fe uhliku bi rihın sarsarin atiyeh.","k":[["وَأَمَّا","ve emma"],["عَادٌۭ","aadun"],["فَأُهْلِكُوا۟","feuhliku"],["بِرِيحٍۢ","birihin"],["صَرْصَرٍ","sarsarin"],["عَاتِيَةٍۢ","aatiyetin"]]},{"v":7,"cuz":29,"sayfa":566,"ar":"سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٍ وَثَمَانِيَةَ اَيَّامٍۙ حُسُوماً فَتَرَى الْقَوْمَ ف۪يهَا صَرْعٰىۙ كَاَنَّهُمْ اَعْجَازُ نَخْلٍ خَاوِيَةٍۚ","ok":"Sehhareha aleyhim seb'a leyalin ve semaniyete eyyamin husumen fe terel kavme fiha sar'a ke ennehum a'cazu nahlin haviyeh.","k":[["سَخَّرَهَا","sehharaha"],["عَلَيْهِمْ","aleyhim"],["سَبْعَ","seb'a"],["لَيَالٍۢ","leyalin"],["وَثَمَـٰنِيَةَ","ve semaniyete"],["أَيَّامٍ","eyyamin"],["حُسُومًۭا","husumen"],["فَتَرَى","fetera"],["ٱلْقَوْمَ","l-kavme"],["فِيهَا","fiha"],["صَرْعَىٰ","sar'aa"],["كَأَنَّهُمْ","keennehum"],["أَعْجَازُ","ea'cazu"],["نَخْلٍ","nehlin"],["خَاوِيَةٍۢ","haviyetin"]]},{"v":8,"cuz":29,"sayfa":566,"ar":"فَهَلْ تَرٰى لَهُمْ مِنْ بَاقِيَةٍ","ok":"Fe hel tera lehum min bakıyeh.","k":[["فَهَلْ","fehel"],["تَرَىٰ","tera"],["لَهُم","lehum"],["مِّنۢ","min"],["بَاقِيَةٍۢ","bakiyetin"]]},{"v":9,"cuz":29,"sayfa":567,"ar":"وَجَٓاءَ فِرْعَوْنُ وَمَنْ قَبْلَهُ وَالْمُؤْتَفِكَاتُ بِالْخَاطِئَةِۚ","ok":"Ve cae fir'avnu ve men kablehu vel mu'tefikatu bil hatıeh.","k":[["وَجَآءَ","ve ca'e"],["فِرْعَوْنُ","fir'avnu"],["وَمَن","ve men"],["قَبْلَهُۥ","kablehu"],["وَٱلْمُؤْتَفِكَـٰتُ","velmu'tefikatu"],["بِٱلْخَاطِئَةِ","bil-hatieti"]]},{"v":10,"cuz":29,"sayfa":567,"ar":"فَعَصَوْا رَسُولَ رَبِّهِمْ فَاَخَذَهُمْ اَخْذَةً رَابِيَةً","ok":"Fe asav resule rabbihim fe ehazehum ahzeten rabiyeh.","k":[["فَعَصَوْا۟","fe asav"],["رَسُولَ","rasule"],["رَبِّهِمْ","rabbihim"],["فَأَخَذَهُمْ","feehazehum"],["أَخْذَةًۭ","ehzeten"],["رَّابِيَةً","rabiyeten"]]},{"v":11,"cuz":29,"sayfa":567,"ar":"اِنَّا لَمَّا طَغَا الْمَٓاءُ حَمَلْنَاكُمْ فِي الْجَارِيَةِۙ","ok":"İnna lemma tagal mau hamelnakum fil cariyeh.","k":[["إِنَّا","inna"],["لَمَّا","lemma"],["طَغَا","taga"],["ٱلْمَآءُ","l-mau"],["حَمَلْنَـٰكُمْ","hamelnakum"],["فِى","fi"],["ٱلْجَارِيَةِ","l-cariyeti"]]},{"v":12,"cuz":29,"sayfa":567,"ar":"لِنَجْعَلَهَا لَكُمْ تَذْكِرَةً وَتَعِيَهَٓا اُذُنٌ وَاعِيَةٌ","ok":"Li nec'aleha lekum tezkireten ve teıyeha uzunun vaıyeh.","k":[["لِنَجْعَلَهَا","linec'aleha"],["لَكُمْ","lekum"],["تَذْكِرَةًۭ","tezkiraten"],["وَتَعِيَهَآ","ve teiyeha"],["أُذُنٌۭ","uzunun"],["وَٰعِيَةٌۭ","vaiyetun"]]},{"v":13,"cuz":29,"sayfa":567,"ar":"فَاِذَا نُفِخَ فِي الصُّورِ نَفْخَةٌ وَاحِدَةٌۙ","ok":"Fe iza nufiha fis suri nefhatun vahıdeh.","k":[["فَإِذَا","feiza"],["نُفِخَ","nufiha"],["فِى","fi"],["ٱلصُّورِ","s-suri"],["نَفْخَةٌۭ","nefhatun"],["وَٰحِدَةٌۭ","vahidetun"]]},{"v":14,"cuz":29,"sayfa":567,"ar":"وَحُمِلَتِ الْاَرْضُ وَالْجِبَالُ فَدُكَّتَا دَكَّةً وَاحِدَةً","ok":"Ve humiletil ardu vel cibalu fe dukketa dekketen vahıdeh.","k":[["وَحُمِلَتِ","ve humileti"],["ٱلْأَرْضُ","l-erdu"],["وَٱلْجِبَالُ","velcibalu"],["فَدُكَّتَا","fe dukketa"],["دَكَّةًۭ","dekketen"],["وَٰحِدَةًۭ","vahideten"]]},{"v":15,"cuz":29,"sayfa":567,"ar":"فَيَوْمَئِذٍ وَقَعَتِ الْوَاقِعَةُۙ","ok":"Fe yevme izin vekaatil vakıah.","k":[["فَيَوْمَئِذٍۢ","feyevmeizin"],["وَقَعَتِ","vekaati"],["ٱلْوَاقِعَةُ","l-vakiatu"]]},{"v":16,"cuz":29,"sayfa":567,"ar":"وَانْشَقَّتِ السَّمَٓاءُ فَهِيَ يَوْمَئِذٍ وَاهِيَةٌۙ","ok":"Ven şakkatis semau fe hiye yevme izin vahiyeh.","k":[["وَٱنشَقَّتِ","venşekkati"],["ٱلسَّمَآءُ","s-semau"],["فَهِىَ","fehiye"],["يَوْمَئِذٍۢ","yevmeizin"],["وَاهِيَةٌۭ","vahiyetun"]]},{"v":17,"cuz":29,"sayfa":567,"ar":"وَالْمَلَكُ عَلٰٓى اَرْجَٓائِهَاۜ وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٍ ثَمَانِيَةٌۜ","ok":"Vel meleku ala ercaiha, ve yahmilu arşe rabbike fevkahum yevme izin semaniyeh.","k":[["وَٱلْمَلَكُ","velmeleku"],["عَلَىٰٓ","ala"],["أَرْجَآئِهَا ۚ","ercaiha"],["وَيَحْمِلُ","ve yehmilu"],["عَرْشَ","arşe"],["رَبِّكَ","rabbike"],["فَوْقَهُمْ","fevkahum"],["يَوْمَئِذٍۢ","yevmeizin"],["ثَمَـٰنِيَةٌۭ","semaniyetun"]]},{"v":18,"cuz":29,"sayfa":567,"ar":"يَوْمَئِذٍ تُعْرَضُونَ لَا تَخْفٰى مِنْكُمْ خَافِيَةٌ","ok":"Yevme izin tu'radune la tahfa minkum hafiyeh.","k":[["يَوْمَئِذٍۢ","yevmeizin"],["تُعْرَضُونَ","tua'radune"],["لَا","la"],["تَخْفَىٰ","tehfa"],["مِنكُمْ","minkum"],["خَافِيَةٌۭ","hafiyetun"]]},{"v":19,"cuz":29,"sayfa":567,"ar":"فَاَمَّا مَنْ اُو۫تِيَ كِتَابَهُ بِيَم۪ينِه۪ فَيَقُولُ هَٓاؤُ۬مُ اقْرَؤُ۫ا كِتَابِيَهْۚ","ok":"Fe emma men utiye kitabehu bi yeminihi fe yekulu haumukreu kitabiyeh.","k":[["فَأَمَّا","feemma"],["مَنْ","men"],["أُوتِىَ","utiye"],["كِتَـٰبَهُۥ","kitabehu"],["بِيَمِينِهِۦ","biyeminihi"],["فَيَقُولُ","feyekulu"],["هَآؤُمُ","ha'umu"],["ٱقْرَءُوا۟","kra'u"],["كِتَـٰبِيَهْ","kitabiyeh"]]},{"v":20,"cuz":29,"sayfa":567,"ar":"اِنّ۪ي ظَنَنْتُ اَنّ۪ي مُلَاقٍ حِسَابِيَهْۚ","ok":"İnni zanentu enniy mülakın hısabiyeh.","k":[["إِنِّى","inni"],["ظَنَنتُ","zenentu"],["أَنِّى","enni"],["مُلَـٰقٍ","mulakin"],["حِسَابِيَهْ","hisabiyeh"]]},{"v":21,"cuz":29,"sayfa":567,"ar":"فَهُوَ ف۪ي ع۪يشَةٍ رَاضِيَةٍۙ","ok":"Fe huve fi işetin radıyeh.","k":[["فَهُوَ","fehuve"],["فِى","fi"],["عِيشَةٍۢ","iyşetin"],["رَّاضِيَةٍۢ","radiyetin"]]},{"v":22,"cuz":29,"sayfa":567,"ar":"ف۪ي جَنَّةٍ عَالِيَةٍۙ","ok":"Fi cennetin aliyeh.","k":[["فِى","fi"],["جَنَّةٍ","cennetin"],["عَالِيَةٍۢ","aaliyetin"]]},{"v":23,"cuz":29,"sayfa":567,"ar":"قُطُوفُهَا دَانِيَةٌ","ok":"Kutufuha daniyeh.","k":[["قُطُوفُهَا","kutufuha"],["دَانِيَةٌۭ","daniyetun"]]},{"v":24,"cuz":29,"sayfa":567,"ar":"كُلُوا وَاشْرَبُوا هَن۪ٓيـٔاً بِمَٓا اَسْلَفْتُمْ فِي الْاَيَّامِ الْخَالِيَةِ","ok":"Kulu veşrebu henien bima esleftum fil eyyamil haliyeh.","k":[["كُلُوا۟","kulu"],["وَٱشْرَبُوا۟","veşrabu"],["هَنِيٓـًٔۢا","heniyen"],["بِمَآ","bima"],["أَسْلَفْتُمْ","esleftum"],["فِى","fi"],["ٱلْأَيَّامِ","l-eyyami"],["ٱلْخَالِيَةِ","l-haliyeti"]]},{"v":25,"cuz":29,"sayfa":567,"ar":"وَاَمَّا مَنْ اُو۫تِيَ كِتَابَهُ بِشِمَالِه۪ فَيَقُولُ يَا لَيْتَن۪ي لَمْ اُو۫تَ كِتَابِيَهْۚ","ok":"Ve emma men utiye kitabehu bi şimalihi fe yekulu ya leyteni lem ute kitabiyeh.","k":[["وَأَمَّا","veemma"],["مَنْ","men"],["أُوتِىَ","utiye"],["كِتَـٰبَهُۥ","kitabehu"],["بِشِمَالِهِۦ","bişimalihi"],["فَيَقُولُ","feyekulu"],["يَـٰلَيْتَنِى","ya leyteni"],["لَمْ","lem"],["أُوتَ","ute"],["كِتَـٰبِيَهْ","kitabiyeh"]]},{"v":26,"cuz":29,"sayfa":567,"ar":"وَلَمْ اَدْرِ مَا حِسَابِيَهْۚ","ok":"Ve lem edri ma hısabiyeh.","k":[["وَلَمْ","velem"],["أَدْرِ","edri"],["مَا","ma"],["حِسَابِيَهْ","hisabiyeh"]]},{"v":27,"cuz":29,"sayfa":567,"ar":"يَا لَيْتَهَا كَانَتِ الْقَاضِيَةَۚ","ok":"Ya leyteha kanetil kadiyeh.","k":[["يَـٰلَيْتَهَا","ya leyteha"],["كَانَتِ","kaneti"],["ٱلْقَاضِيَةَ","l-kadiyete"]]},{"v":28,"cuz":29,"sayfa":567,"ar":"مَٓا اَغْنٰى عَنّ۪ي مَالِيَهْۚ","ok":"Ma agna anni maliyeh.","k":[["مَآ","ma"],["أَغْنَىٰ","egna"],["عَنِّى","anni"],["مَالِيَهْ ۜ","maliyeh"]]},{"v":29,"cuz":29,"sayfa":567,"ar":"هَلَكَ عَنّ۪ي سُلْطَانِيَهْۚ","ok":"Heleke anni sultaniyeh.","k":[["هَلَكَ","heleke"],["عَنِّى","anni"],["سُلْطَـٰنِيَهْ","sultaniyeh"]]},{"v":30,"cuz":29,"sayfa":567,"ar":"خُذُوهُ فَغُلُّوهُۙ","ok":"Huzuhu fe gulluh.","k":[["خُذُوهُ","huzuhu"],["فَغُلُّوهُ","fe gulluhu"]]},{"v":31,"cuz":29,"sayfa":567,"ar":"ثُمَّ الْجَح۪يمَ صَلُّوهُۙ","ok":"Summel cahime salluh.","k":[["ثُمَّ","summe"],["ٱلْجَحِيمَ","l-cehime"],["صَلُّوهُ","salluhu"]]},{"v":32,"cuz":29,"sayfa":567,"ar":"ثُمَّ ف۪ي سِلْسِلَةٍ ذَرْعُهَا سَبْعُونَ ذِرَاعاً فَاسْلُكُوهُۜ","ok":"Summe fi silsiletin zer'uha seb'une ziraan feslukuh.","k":[["ثُمَّ","summe"],["فِى","fi"],["سِلْسِلَةٍۢ","silsiletin"],["ذَرْعُهَا","zer'uha"],["سَبْعُونَ","seb'une"],["ذِرَاعًۭا","ziraan"],["فَٱسْلُكُوهُ","feslukuhu"]]},{"v":33,"cuz":29,"sayfa":567,"ar":"اِنَّهُ كَانَ لَا يُؤْمِنُ بِاللّٰهِ الْعَظ۪يمِۙ","ok":"İnnehu kane la yu'minu billahil azim.","k":[["إِنَّهُۥ","innehu"],["كَانَ","kane"],["لَا","la"],["يُؤْمِنُ","yu'minu"],["بِٱللَّهِ","billahi"],["ٱلْعَظِيمِ","l-azimi"]]},{"v":34,"cuz":29,"sayfa":567,"ar":"وَلَا يَحُضُّ عَلٰى طَعَامِ الْمِسْك۪ينِۜ","ok":"Ve la yahuddu ala taamil miskin.","k":[["وَلَا","ve la"],["يَحُضُّ","yehuddu"],["عَلَىٰ","ala"],["طَعَامِ","taaami"],["ٱلْمِسْكِينِ","l-miskini"]]},{"v":35,"cuz":29,"sayfa":568,"ar":"فَلَيْسَ لَهُ الْيَوْمَ هٰهُنَا حَم۪يمٌۙ","ok":"Fe leyse lehul yevme hahuna hamim.","k":[["فَلَيْسَ","feleyse"],["لَهُ","lehu"],["ٱلْيَوْمَ","l-yevme"],["هَـٰهُنَا","hahuna"],["حَمِيمٌۭ","hamimun"]]},{"v":36,"cuz":29,"sayfa":568,"ar":"وَلَا طَعَامٌ اِلَّا مِنْ غِسْل۪ينٍۙ","ok":"Ve la taamun illa min gıslin.","k":[["وَلَا","ve la"],["طَعَامٌ","taaamun"],["إِلَّا","illa"],["مِنْ","min"],["غِسْلِينٍۢ","gislinin"]]},{"v":37,"cuz":29,"sayfa":568,"ar":"لَا يَأْكُلُهُٓ اِلَّا الْخَاطِؤُ۫نَ۟","ok":"La ye'kuluhu illel hatiun.","k":[["لَّا","la"],["يَأْكُلُهُۥٓ","ye'kuluhu"],["إِلَّا","illa"],["ٱلْخَـٰطِـُٔونَ","l-hatiune"]]},{"v":38,"cuz":29,"sayfa":568,"ar":"فَلَٓا اُقْسِمُ بِمَا تُبْصِرُونَۙ","ok":"Fe la uksımu bima tubsırun.","k":[["فَلَآ","fela"],["أُقْسِمُ","uksimu"],["بِمَا","bima"],["تُبْصِرُونَ","tubsirune"]]},{"v":39,"cuz":29,"sayfa":568,"ar":"وَمَا لَا تُبْصِرُونَۙ","ok":"Ve ma la tubsırun.","k"