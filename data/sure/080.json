{"s":80,"ad":"Abese","ayetler":[{"v":1,"cuz":30,"sayfa":585,"ar":"عَبَسَ وَتَوَلّٰىۙ","ok":"Abese ve tevella.","k":[["عَبَسَ","abese"],["وَتَوَلَّىٰٓ","ve tevella"]]},{"v":2,"cuz":30,"sayfa":585,"ar":"اَنْ جَٓاءَهُ الْاَعْمٰىۜ","ok":"En caehul a'ma.","k":[["أَن","en"],["جَآءَهُ","ca'ehu"],["ٱلْأَعْمَىٰ","l-ea'ma"]]},{"v":3,"cuz":30,"sayfa":585,"ar":"وَمَا يُدْر۪يكَ لَعَلَّهُ يَزَّكّٰىۙ","ok":"Ve ma yudrike leallehu yezzekka.","k":[["وَمَا","vema"],["يُدْرِيكَ","yudrike"],["لَعَلَّهُۥ","leallehu"],["يَزَّكَّىٰٓ","yezzekka"]]},{"v":4,"cuz":30,"sayfa":585,"ar":"اَوْ يَذَّكَّرُ فَتَنْفَعَهُ الذِّكْرٰىۜ","ok":"Ev yezzekkeru fe tenfeahuz zikra.","k":[["أَوْ","ev"],["يَذَّكَّرُ","yezzekkeru"],["فَتَنفَعَهُ","fetenfeahu"],["ٱلذِّكْرَىٰٓ","z-zikra"]]},{"v":5,"cuz":30,"sayfa":585,"ar":"اَمَّا مَنِ اسْتَغْنٰىۙ","ok":"Emma menistagna.","k":[["أَمَّا","emma"],["مَنِ","meni"],["ٱسْتَغْنَىٰ","stegna"]]},{"v":6,"cuz":30,"sayfa":585,"ar":"فَاَنْتَ لَهُ تَصَدّٰىۜ","ok":"Fe ente lehu tesadda.","k":[["فَأَنتَ","feente"],["لَهُۥ","lehu"],["تَصَدَّىٰ","tesadda"]]},{"v":7,"cuz":30,"sayfa":585,"ar":"وَمَا عَلَيْكَ اَلَّا يَزَّكّٰىۜ","ok":"Ve ma aleyke ella yezzekka.","k":[["وَمَا","ve ma"],["عَلَيْكَ","aleyke"],["أَلَّا","ella"],["يَزَّكَّىٰ","yezzekka"]]},{"v":8,"cuz":30,"sayfa":585,"ar":"وَاَمَّا مَنْ جَٓاءَكَ يَسْعٰىۙ","ok":"Ve emma men caeke yes'a.","k":[["وَأَمَّا","veemma"],["مَن","men"],["جَآءَكَ","ca'eke"],["يَسْعَىٰ","yes'aa"]]},{"v":9,"cuz":30,"sayfa":585,"ar":"وَهُوَ يَخْشٰىۙ","ok":"Ve huve yahşa.","k":[["وَهُوَ","vehuve"],["يَخْشَىٰ","yehşa"]]},{"v":10,"cuz":30,"sayfa":585,"ar":"فَاَنْتَ عَنْهُ تَلَهّٰىۚ","ok":"Fe ente anhu telehha.","k":[["فَأَنتَ","feente"],["عَنْهُ","anhu"],["تَلَهَّىٰ","telehha"]]},{"v":11,"cuz":30,"sayfa":585,"ar":"كَلَّٓا اِنَّهَا تَذْكِرَةٌۚ","ok":"Kella inneha tezkirah.","k":[["كَلَّآ","kella"],["إِنَّهَا","inneha"],["تَذْكِرَةٌۭ","tezkiratun"]]},{"v":12,"cuz":30,"sayfa":585,"ar":"فَمَنْ شَٓاءَ ذَكَرَهُۢ","ok":"Fe men şae zekerah.","k":[["فَمَن","fem