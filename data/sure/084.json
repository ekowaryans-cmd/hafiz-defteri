{"s":84,"ad":"İnşikak","ayetler":[{"v":1,"cuz":30,"sayfa":589,"ar":"اِذَا السَّمَٓاءُ انْشَقَّتْۙ","ok":"İzes semaunşakkat.","k":[["إِذَا","iza"],["ٱلسَّمَآءُ","s-semau"],["ٱنشَقَّتْ","nşekkat"]]},{"v":2,"cuz":30,"sayfa":589,"ar":"وَاَذِنَتْ لِرَبِّهَا وَحُقَّتْۙ","ok":"Ve ezinet li rabbiha ve hukkat.","k":[["وَأَذِنَتْ","ve ezinet"],["لِرَبِّهَا","lirabbiha"],["وَحُقَّتْ","ve hukkat"]]},{"v":3,"cuz":30,"sayfa":589,"ar":"وَاِذَا الْاَرْضُ مُدَّتْۙ","ok":"Ve izel ardu muddet.","k":[["وَإِذَا","ve iza"],["ٱلْأَرْضُ","l-erdu"],["مُدَّتْ","muddet"]]},{"v":4,"cuz":30,"sayfa":589,"ar":"وَاَلْقَتْ مَا ف۪يهَا وَتَخَلَّتْۙ","ok":"Ve elkat ma fiha ve tehallet.","k":[["وَأَلْقَتْ","ve elkat"],["مَا","ma"],["فِيهَا","fiha"],["وَتَخَلَّتْ","ve tehallet"]]},{"v":5,"cuz":30,"sayfa":589,"ar":"وَاَذِنَتْ لِرَبِّهَا وَحُقَّتْۜ","ok":"Ve ezinet li rabbiha ve hukkat.","k":[["وَأَذِنَتْ","ve ezinet"],["لِرَبِّهَا","lirabbiha"],["وَحُقَّتْ","ve hukkat"]]},{"v":6,"cuz":30,"sayfa":589,"ar":"يَٓا اَيُّهَا الْاِنْسَانُ اِنَّكَ كَادِحٌ اِلٰى رَبِّكَ كَدْحاً فَمُلَاق۪يهِۚ","ok":"Ya eyyuhel insanu inneke kadihun ila rabbike kedhan fe mulakih.","k":[["يَـٰٓأَيُّهَا","ya eyyuha"],["ٱلْإِنسَـٰنُ","l-insanu"],["إِنَّكَ","inneke"],["كَادِحٌ","kadihun"],["إِلَىٰ","ila"],["رَبِّكَ","rabbike"],["كَدْحًۭا","kedhen"],["فَمُلَـٰقِيهِ","fe mulakihi"]]},{"v":7,"cuz":30,"sayfa":589,"ar":"فَاَمَّا مَنْ اُو۫تِيَ كِتَابَهُ بِيَم۪ينِه۪ۙ","ok":"Fe emma men utiye kitabehu bi yeminih.","k":[["فَأَمَّا","feemma"],["مَنْ","men"],["أُوتِىَ","utiye"],["كِتَـٰبَهُۥ","kitabehu"],["بِيَمِينِهِۦ","biyeminihi"]]},{"v":8,"cuz":30,"sayfa":589,"ar":"فَسَوْفَ يُحَاسَبُ حِسَاباً يَس۪يراًۙ","ok":"Fe sevfe yuhasebu hısaben yesira.","k":[["فَسَوْفَ","fesevfe"],["يُحَاسَبُ","yuhasebu"],["حِسَابًۭا","hisaben"],["يَسِيرًۭا","yesiran"]]},{"v":9,"cuz":30,"sayfa":589,"ar":"وَيَنْقَلِبُ اِلٰٓى اَهْلِه۪ مَسْرُوراًۜ","ok":"Ve yenkalibu ila ehlihi mesrura.","k":[["وَيَنقَلِبُ","ve yenkalibu"],["إِلَىٰٓ","ila"],["أَهْلِهِۦ","ehlihi"],["مَسْرُورًۭا","mesruran"]]},{"v":10,"cuz":30,"sayfa":589,"ar":"وَاَمَّا مَنْ اُو۫تِيَ كِتَابَهُ وَرَٓاءَ ظَهْرِه۪ۙ","ok":"Ve emma men utiye kitabehu verae zahrih.","k":[["وَأَمَّا","veemma"],["مَنْ","men"],["أُوتِىَ","utiye"],["كِتَـٰبَهُۥ","kitabehu"],["وَرَآءَ","vera'e"],["ظَهْرِهِۦ","zehrihi"]]},{"v":11,"cuz":30,"sayfa":589,"ar":"فَسَوْفَ يَدْعُوا ثُبُوراًۙ","ok":"Fe sevfe yed'u subura.","k":[["فَسَوْفَ","fesevfe"],["يَدْعُوا۟","yed'u"],["ثُبُورًۭا","suburan"]]},{"v":12,"cuz":30,"sayfa":589,"ar":"وَيَصْلٰى سَع۪يراًۜ","ok":"Ve yasla saira.","k":[["وَيَصْلَىٰ","ve yesla"],["سَعِيرًا","seiyran"]]},{"v":13,"cuz":30,"sayfa":589,"ar":"اِنَّهُ  كَانَ ف۪ٓي اَهْلِه۪ مَسْرُوراً","ok":"İnnehu kane fi ehlihi mesrura.","k":[["إِنَّهُۥ","innehu"],["كَانَ","kane"],["فِىٓ","fi"],["أَهْلِهِۦ","ehlihi"],["مَسْرُورًا","mesruran"]]},{"v":14,"cuz":30,"sayfa":589,"ar":"اِنَّهُ ظَنَّ اَنْ لَنْ يَحُورَۚۛ","ok":"İnnehu zanne en len yahur.","k":[["إِنَّهُۥ","innehu"],["ظَنَّ","zenne"],["أَن","en"],["لَّن","len"],["يَحُورَ","yehura"]]},{"v":15,"cuz":30,"sayfa":589,"ar":"بَلٰىۚۛ  اِنَّ رَبَّهُ  كَانَ بِه۪ بَص۪يراًۜ","ok":"Bela, inne rabbehu kane bihi basira.","k":[["بَلَىٰٓ","bela"],["إِنَّ","inne"],["رَبَّهُۥ","rabbehu"],["كَانَ","kane"],["بِهِۦ","bihi"],["بَصِيرًۭا","besiran"]]},{"v":16,"cuz":30,"sayfa":589,"ar":"فَلَٓا اُقْسِمُ بِالشَّفَقِۙ","ok":"Fe la uksimu biş şefak.","k":[["فَلَآ","fela"],["أُقْسِمُ","uksimu"],["بِٱلشَّفَقِ","biş-şefeki"]]},{"v":17,"cuz":30,"sayfa":589,"ar":"وَالَّيْلِ وَمَا وَسَقَۙ","ok":"Vel leyli ve ma vesak.","k":[["وَٱلَّيْلِ","velleyli"],["وَمَا","ve ma"],["وَسَقَ","veseka"]]},{"v":18,"cuz":30,"sayfa":589,"ar":"وَالْقَمَرِ اِذَا اتَّسَقَۙ","ok":"Vel kameri izet tesak.","k":[["وَٱلْقَمَرِ","velkameri"],["إِذَا","iza"],["ٱتَّسَقَ","tteseka"]]},{"v":19,"cuz":30,"sayfa":589,"ar":"لَتَرْكَبُنَّ طَبَقاً عَنْ طَبَقٍۜ","ok":"Le terkebunne tabakan an tabakın.","k":[["لَتَرْكَبُنَّ","leterkebunne"],["طَبَقًا","tabekan"],["عَن","an"],["طَبَقٍۢ","tabekin"]]},{"v":20,"cuz":30,"sayfa":589,"ar":"فَمَا لَهُمْ لَا يُؤْمِنُونَۙ","ok":"Fe ma lehum la yu'minun.","k":[["فَمَا","fema"],["لَهُمْ","lehum"],["لَا","la"],["يُؤْمِنُونَ","yu'minune"]]},{"v":21,"cuz":30,"sayfa":589,"ar":"وَاِذَا قُرِئَ عَلَيْهِمُ الْقُرْاٰنُ لَا يَسْجُدُونَۜ","ok":"Ve iza kurıe aleyhimul kur'anu la yescudun.","k":[["وَإِذَا","ve iza"],["قُرِئَ","kurie"],["عَلَيْهِمُ","aleyhimu"],["ٱلْقُرْءَانُ","l-kuranu"],["لَا","la"],["يَسْجُدُونَ ۩","yescudune"]]},{"v":22,"cuz":30,"sayfa":589,"ar":"بَلِ الَّذ۪ينَ كَفَرُوا يُكَذِّبُونَۘ","ok":"Belillezine keferu yukezzibun.","k":[["بَلِ","beli"],["ٱلَّذِينَ","ellezine"],["كَفَرُوا۟","keferu"],["يُكَذِّبُونَ","yukezzibune"]]},{"v":23,"cuz":30,"sayfa":589,"ar":"وَاللّٰهُ اَعْلَمُ بِمَا يُوعُونَۘ","ok":"Vallahu a'lemu bima yuun.","k":[["وَٱللَّهُ","vallahu"],["أَعْلَمُ","ea'lemu"],["بِمَا","bima"],["يُوعُونَ","yuune"]]},{"v":24,"cuz":30,"sayfa":589,"ar":"فَبَشِّرْهُمْ بِعَذَابٍ اَل۪يمٍۙ","ok":"Fe beşşirhum bi azabin elim.","k":[["فَبَشِّرْهُم","febeşşirhum"],["بِعَذَابٍ","biazabin"],["أَلِيمٍ","elimin"]]},{"v":25,"cuz":30,"sayfa":589,"ar":"اِلَّا الَّذ۪ينَ اٰمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ اَجْرٌ غَيْرُ مَمْنُونٍ","ok":"İllellezine amenu ve amilus salihati lehum ecrun gayru memnun.","k":[["إِلَّا","illa"],["ٱلَّذِينَ","ellezine"],["ءَامَنُوا۟","amenu"],["وَعَمِلُوا۟","ve amilu"],["ٱلصَّـٰلِحَـٰتِ","s-salihati"],["لَهُمْ","lehum"],["أَجْرٌ","ecrun"],["غَيْرُ","gayru"],["مَمْنُونٍۭ","memnunin"]]}]}