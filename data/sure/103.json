{"s":103,"ad":"Asr","ayetler":[{"v":1,"cuz":30,"sayfa":601,"ar":"وَالْعَصْرِۙ","ok":"Vel asr.","k":[["وَٱلْعَصْرِ","vel'asri"]]},{"v":2,"cuz":30,"sayfa":601,"ar":"اِنَّ الْاِنْسَانَ لَف۪ي خُسْرٍۙ","ok":"İnnel insane le fi husr.","k":[["إِنَّ","inne"],["ٱلْإِنسَـٰنَ","l-insane"],["لَفِى","lefi"],["خُسْرٍ","husrin"]]},{"v":3,"cuz":30,"sayfa":601,"ar":"اِلَّا الَّذ۪ينَ اٰمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَتَوَاصَوْا بِالْحَقِّ وَتَوَاصَوْا بِالصَّبْرِ","ok":"İllellezine amenu ve amilus salihati ve tevasav bil hakkı ve tevasav bis sabr.","k":[["إِلَّا","illa"],["ٱلَّذِينَ","ellezine"],["ءَامَنُوا۟","amenu"],["وَعَمِلُوا۟","ve amilu"],["ٱلصَّـٰلِحَـٰتِ","s-salihati"],["وَتَوَاصَوْا۟","ve tevasav"],["بِٱلْحَقِّ","bil-hakki"],["وَتَوَاصَوْا۟","ve tevasav"],["بِٱلصَّبْرِ","bis-sabri"]]}]}