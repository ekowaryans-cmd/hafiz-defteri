{"s":53,"ad":"Necm","ayetler":[{"v":1,"cuz":27,"sayfa":526,"ar":"وَالنَّجْمِ اِذَا هَوٰىۙ","ok":"Ven necmi iza heva.","k":[["وَٱلنَّجْمِ","vennecmi"],["إِذَا","iza"],["هَوَىٰ","heva"]]},{"v":2,"cuz":27,"sayfa":526,"ar":"مَا ضَلَّ صَاحِبُكُمْ وَمَا غَوٰىۚ","ok":"Ma dalle sahıbukum ve ma gava.","k":[["مَا","ma"],["ضَلَّ","delle"],["صَاحِبُكُمْ","sahibukum"],["وَمَا","ve ma"],["غَوَىٰ","gava"]]},{"v":3,"cuz":27,"sayfa":526,"ar":"وَمَا يَنْطِقُ عَنِ الْهَوٰىۜ","ok":"Ve ma yentıku anil heva.","k":[["وَمَا","ve ma"],["يَنطِقُ","yentiku"],["عَنِ","ani"],["ٱلْهَوَىٰٓ","l-heva"]]},{"v":4,"cuz":27,"sayfa":526,"ar":"اِنْ هُوَ اِلَّا وَحْيٌ يُوحٰىۙ","ok":"İn huve illa vahyun yuha.","k":[["إِنْ","in"],["هُوَ","huve"],["إِلَّا","illa"],["وَحْىٌۭ","vehyun"],["يُوحَىٰ","yuha"]]},{"v":5,"cuz":27,"sayfa":526,"ar":"عَلَّمَهُ شَد۪يدُ الْقُوٰىۙ","ok":"Allemehu şedidul kuva.","k":[["عَلَّمَهُۥ","allemehu"],["شَدِيدُ","şedidu"],["ٱلْقُوَىٰ","l-kuva"]]},{"v":6,"cuz":27,"sayfa":526,"ar":"ذُومِرَّةٍۜ  فَاسْتَوٰىۙ","ok":"Zu mirreh, festeva.","k":[["ذُو","zu"],["مِرَّةٍۢ","mirratin"],["فَٱسْتَوَىٰ","festeva"]]},{"v":7,"cuz":27,"sayfa":526,"ar":"وَهُوَ بِالْاُفُقِ الْاَعْلٰىۜ","ok":"Ve huve bil ufukil a'la.","k":[["وَهُوَ","vehuve"],["بِٱلْأُفُقِ","bil-ufuki"],["ٱلْأَعْلَىٰ","l-ea'la"]]},{"v":8,"cuz":27,"sayfa":526,"ar":"ثُمَّ دَنَا فَتَدَلّٰىۙ","ok":"Summe dena fe tedella.","k":[["ثُمَّ","summe"],["دَنَا","dena"],["فَتَدَلَّىٰ","fe tedella"]]},{"v":9,"cuz":27,"sayfa":526,"ar":"فَكَانَ قَابَ قَوْسَيْنِ اَوْ اَدْنٰىۚ","ok":"Fe kane kabe kavseyni ev edna.","k":[["فَكَانَ","fe kane"],["قَابَ","kabe"],["قَوْسَيْنِ","kavseyni"],["أَوْ","ev"],["أَدْنَىٰ","edna"]]},{"v":10,"cuz":27,"sayfa":526,"ar":"فَاَوْحٰٓى اِلٰى عَبْدِه۪ مَٓا اَوْحٰىۜ","ok":"Fe evha ila abdihi ma evha.","k":[["فَأَوْحَىٰٓ","feevha"],["إِلَىٰ","ila"],["عَبْدِهِۦ","abdihi"],["مَآ","ma"],["أَوْحَىٰ","evha"]]},{"v":11,"cuz":27,"sayfa":526,"ar":"مَا كَذَبَ الْفُؤٰ۬ادُ مَا رَاٰى","ok":"Ma kezebel fuadu ma rea.","k":[["مَا","ma"],["كَذَبَ","kezebe"],["ٱلْفُؤَادُ","l-fu'adu"],["مَا","ma"],["رَأَىٰٓ","raa"]]},{"v":12,"cuz":27,"sayfa":526,"ar":"اَفَتُمَارُونَهُ عَلٰى مَا يَرٰى","ok":"E fe tumar runehu ala ma yera.","k":[["أَفَتُمَـٰرُونَهُۥ","efetumarunehu"],["عَلَىٰ","ala"],["مَا","ma"],["يَرَىٰ","yera"]]},{"v":13,"cuz":27,"sayfa":526,"ar":"وَلَقَدْ رَاٰهُ نَزْلَةً اُخْرٰىۙ","ok":"Ve lekad reahu nezleten uhra.","k":[["وَلَقَدْ","velekad"],["رَءَاهُ","rahu"],["نَزْلَةً","nezleten"],["أُخْرَىٰ","uhra"]]},{"v":14,"cuz":27,"sayfa":526,"ar":"عِنْدَ سِدْرَةِ الْمُنْتَهٰى","ok":"İnde sidretil munteha.","k":[["عِندَ","inde"],["سِدْرَةِ","sidrati"],["ٱلْمُنتَهَىٰ","l-munteha"]]},{"v":15,"cuz":27,"sayfa":526,"ar":"عِنْدَهَا جَنَّةُ الْمَأْوٰىۜ","ok":"İndeha cennetul me'va.","k":[["عِندَهَا","indeha"],["جَنَّةُ","cennetu"],["ٱلْمَأْوَىٰٓ","l-me'va"]]},{"v":16,"cuz":27,"sayfa":526,"ar":"اِذْ يَغْشَى السِّدْرَةَ مَا يَغْشٰىۙ","ok":"İz yagşes sidrete ma yagşa.","k":[["إِذْ","iz"],["يَغْشَى","yegşa"],["ٱلسِّدْرَةَ","s-sidrate"],["مَا","ma"],["يَغْشَىٰ","yegşa"]]},{"v":17,"cuz":27,"sayfa":526,"ar":"مَا زَاغَ الْبَصَرُ وَمَا طَغٰى","ok":"Ma zagal basaru ve ma tega.","k":[["مَا","ma"],["زَاغَ","zaga"],["ٱلْبَصَرُ","l-besaru"],["وَمَا","ve ma"],["طَغَىٰ","taga"]]},{"v":18,"cuz":27,"sayfa":526,"ar":"لَقَدْ رَاٰى مِنْ اٰيَاتِ رَبِّهِ الْـكُبْرٰى","ok":"Lekad rea min ayati rabbihil kubra.","k":[["لَقَدْ","lekad"],["رَأَىٰ","raa"],["مِنْ","min"],["ءَايَـٰتِ","ayati"],["رَبِّهِ","rabbihi"],["ٱلْكُبْرَىٰٓ","l-kubra"]]},{"v":19,"cuz":27,"sayfa":526,"ar":"اَفَرَاَيْتُمُ اللَّاتَ وَالْعُزّٰىۙ","ok":"E fe reeytumul late vel uzza.","k":[["أَفَرَءَيْتُمُ","eferaeytumu"],["ٱللَّـٰتَ","l-late"],["وَٱلْعُزَّىٰ","vel'uzza"]]},{"v":20,"cuz":27,"sayfa":526,"ar":"وَمَنٰوةَ الثَّالِثَةَ الْاُخْرٰى","ok":"Ve menates salisetel uhra.","k":[["وَمَنَوٰةَ","ve menate"],["ٱلثَّالِثَةَ","s-salisete"],["ٱلْأُخْرَىٰٓ","l-uhra"]]},{"v":21,"cuz":27,"sayfa":526,"ar":"اَلَـكُمُ الذَّكَرُ وَلَهُ الْاُنْثٰى","ok":"E lekumuz zekeru ve lehul unsa.","k":[["أَلَكُمُ","elekumu"],["ٱلذَّكَرُ","z-zekeru"],["وَلَهُ","velehu"],["ٱلْأُنثَىٰ","l-unsa"]]},{"v":22,"cuz":27,"sayfa":526,"ar":"تِلْكَ اِذاً قِسْمَةٌ ض۪يزٰى","ok":"Tilke izen kısmetun diza.","k":[["تِلْكَ","tilke"],["إِذًۭا","izen"],["قِسْمَةٌۭ","kismetun"],["ضِيزَىٰٓ","diza"]]},{"v":23,"cuz":27,"sayfa":526,"ar":"اِنْ هِيَ اِلَّٓا اَسْمَٓاءٌ سَمَّيْتُمُوهَٓا اَنْتُمْ وَاٰبَٓاؤُ۬كُمْ مَٓا اَنْزَلَ اللّٰهُ بِهَا مِنْ سُلْطَانٍۜ اِنْ يَتَّبِعُونَ اِلَّا الظَّنَّ وَمَا تَهْوَى الْاَنْفُسُۚ وَلَقَدْ جَٓاءَهُمْ مِنْ رَبِّهِمُ الْهُدٰىۜ","ok":"İn hiye illa esmaun semmeytumuha entum ve abaukum ma enzelallahu biha min sultan, in yettebiune illez zanne ve ma tehvel enfus, ve lekad caehum min rabbihimul huda.","k":[["إِنْ","in"],["هِىَ","hiye"],["إِلَّآ","illa"],["أَسْمَآءٌۭ","esma'un"],["سَمَّيْتُمُوهَآ","semmeytumuha"],["أَنتُمْ","entum"],["وَءَابَآؤُكُم","ve aba'ukum"],["مَّآ","ma"],["أَنزَلَ","enzele"],["ٱللَّهُ","llahu"],["بِهَا","biha"],["مِن","min"],["سُلْطَـٰنٍ ۚ","sultanin"],["إِن","in"],["يَتَّبِعُونَ","yettebiune"],["إِلَّا","illa"],["ٱلظَّنَّ","z-zenne"],["وَمَا","ve ma"],["تَهْوَى","tehva"],["ٱلْأَنفُسُ ۖ","l-enfusu"],["وَلَقَدْ","velekad"],["جَآءَهُم","ca'ehum"],["مِّن","min"],["رَّبِّهِمُ","rabbihimu"],["ٱلْهُدَىٰٓ","l-huda"]]},{"v":24,"cuz":27,"sayfa":526,"ar":"اَمْ لِلْاِنْسَانِ مَا تَمَنّٰىۘ","ok":"Em lil insani ma temenna.","k":[["أَمْ","em"],["لِلْإِنسَـٰنِ","lilinsani"],["مَا","ma"],["تَمَنَّىٰ","temenna"]]},{"v":25,"cuz":27,"sayfa":526,"ar":"فَلِلّٰهِ الْاٰخِرَةُ وَالْاُو۫لٰى۟","ok":"Fe lillahil ahiretu vel ula.","k":[["فَلِلَّهِ","felillahi"],["ٱلْـَٔاخِرَةُ","l-ahiratu"],["وَٱلْأُولَىٰ","velula"]]},{"v":26,"cuz":27,"sayfa":526,"ar":"وَكَمْ مِنْ مَلَكٍ فِي السَّمٰوَاتِ لَا تُغْن۪ي شَفَاعَتُهُمْ شَيْـٔاً اِلَّا مِنْ بَعْدِ اَنْ يَأْذَنَ اللّٰهُ لِمَنْ يَشَٓاءُ وَيَرْضٰى","ok":"Ve kem min melekin fis semavati la tugni şefaatuhum şey'en illa min ba'di en ye'zenallahu limen yeşau ve yerda.","k":[["وَكَم","ve kem"],["مِّن","min"],["مَّلَكٍۢ","melekin"],