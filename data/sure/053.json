bi men dalle an sebilihi ve huve a'lemu bi menihteda.","k":[["ذَٰلِكَ","zalike"],["مَبْلَغُهُم","mebleguhum"],["مِّنَ","mine"],["ٱلْعِلْمِ ۚ","l-ilmi"],["إِنَّ","inne"],["رَبَّكَ","rabbeke"],["هُوَ","huve"],["أَعْلَمُ","ea'lemu"],["بِمَن","bimen"],["ضَلَّ","delle"],["عَن","an"],["سَبِيلِهِۦ","sebilihi"],["وَهُوَ","ve huve"],["أَعْلَمُ","ea'lemu"],["بِمَنِ","bimeni"],["ٱهْتَدَىٰ","hteda"]]},{"v":31,"cuz":27,"sayfa":527,"ar":"وَلِلّٰهِ مَا فِي السَّمٰوَاتِ وَمَا فِي الْاَرْضِۙ لِيَجْزِيَ الَّذ۪ينَ اَسَٓاؤُ۫ا بِمَا عَمِلُوا وَيَجْزِيَ الَّذ۪ينَ اَحْسَنُوا بِالْحُسْنٰىۚ","ok":"Ve lillahi ma fis semavati ve ma fil ardı li yecziyellezine esau bima amilu ve yecziyellezine ahsenu bil husna.","k":[["وَلِلَّهِ","velillahi"],["مَا","ma"],["فِى","fi"],["ٱلسَّمَـٰوَٰتِ","s-semavati"],["وَمَا","ve ma"],["فِى","fi"],["ٱلْأَرْضِ","l-erdi"],["لِيَجْزِىَ","liyecziye"],["ٱلَّذِينَ","ellezine"],["أَسَـٰٓـُٔوا۟","esa'u"],["بِمَا","bima"],["عَمِلُوا۟","amilu"],["وَيَجْزِىَ","ve yecziye"],["ٱلَّذِينَ","ellezine"],["أَحْسَنُوا۟","ehsenu"],["بِٱلْحُسْنَى","bil-husna"]]},{"v":32,"cuz":27,"sayfa":527,"ar":"اَلَّذ۪ينَ يَجْتَنِبُونَ كَـبَٓائِرَ الْاِثْمِ وَالْفَوَاحِشَ اِلَّا اللَّمَمَۜ اِنَّ رَبَّكَ وَاسِعُ الْمَغْفِرَةِۜ هُوَ اَعْلَمُ بِكُمْ اِذْ اَنْشَاَكُمْ مِنَ الْاَرْضِ وَاِذْ اَنْتُمْ اَجِنَّةٌ ف۪ي بُطُونِ اُمَّهَاتِكُمْۚ فَلَا تُزَكُّٓوا اَنْفُسَكُمْۜ هُوَ اَعْلَمُ بِمَنِ اتَّقٰى۟","ok":"Ellezine yectenibune kebairel ismi vel fevahışe illâ-llemem, inne rabbeke vasiul magfireh, huve a'lemu bikum iz enşeekum minel ardı ve iz entum e cinnetun fi butuni ummehatikum, fe la tuzekku enfusekum, huve a'lemu bi menitteka.","k":[["ٱلَّذِينَ","ellezine"],["يَجْتَنِبُونَ","yectenibune"],["كَبَـٰٓئِرَ","kebaira"],["ٱلْإِثْمِ","l-ismi"],["وَٱلْفَوَٰحِشَ","velfevahişe"],["إِلَّا","illa"],["ٱللَّمَمَ ۚ","l-lememe"],["إِنَّ","inne"],["رَبَّكَ","rabbeke"],["وَٰسِعُ","vasiu"],["ٱلْمَغْفِرَةِ ۚ","l-megfirati"],["هُوَ","huve"],["أَعْلَمُ","ea'lemu"],["بِكُمْ","bikum"],["إِذْ","iz"],["أَنشَأَكُم","enşeekum"],