{"s":78,"ad":"Nebe","ayetler":[{"v":1,"cuz":30,"sayfa":582,"ar":"عَمَّ يَتَسَٓاءَلُونَۚ","ok":"Amme yetesaelun.","k":[["عَمَّ","amme"],["يَتَسَآءَلُونَ","yetesa'elune"]]},{"v":2,"cuz":30,"sayfa":582,"ar":"عَنِ النَّبَأِ الْعَظ۪يمِۙ","ok":"Anin nebeil azim.","k":[["عَنِ","ani"],["ٱلنَّبَإِ","n-nebei"],["ٱلْعَظِيمِ","l-azimi"]]},{"v":3,"cuz":30,"sayfa":582,"ar":"اَلَّذ۪ي هُمْ ف۪يهِ مُخْتَلِفُونَۜ","ok":"Ellezi hum fihi muhtelifun.","k":[["ٱلَّذِى","ellezi"],["هُمْ","hum"],["فِيهِ","fihi"],["مُخْتَلِفُونَ","muhtelifune"]]},{"v":4,"cuz":30,"sayfa":582,"ar":"كَلَّا سَيَعْلَمُونَۙ","ok":"Kella se ya'lemun.","k":[["كَلَّا","kella"],["سَيَعْلَمُونَ","seyea'lemune"]]},{"v":5,"cuz":30,"sayfa":582,"ar":"ثُمَّ كَلَّا سَيَعْلَمُونَ","ok":"Summe kella se ya'lemun.","k":[["ثُمَّ","summe"],["كَلَّا","kella"],["سَيَعْلَمُونَ","seyea'lemune"]]},{"v":6,"cuz":30,"sayfa":582,"ar":"اَلَمْ نَجْعَلِ الْاَرْضَ مِهَاداًۙ","ok":"E lem nec'alil arda mihada.","k":[["أَلَمْ","elem"],["نَجْعَلِ","nec'ali"],["ٱلْأَرْضَ","l-erde"],["مِهَـٰدًۭا","mihaden"]]},{"v":7,"cuz":30,"sayfa":582,"ar":"وَالْجِبَالَ اَوْتَاداًۖ","ok":"Vel cibale evtada.","k":[["وَٱلْجِبَالَ","velcibale"],["أَوْتَادًۭا","evtaden"]]},{"v":8,"cuz":30,"sayfa":582,"ar":"وَخَلَقْنَاكُمْ اَزْوَاجاًۙ","ok":"Ve halaknakum ezvaca.","k":[["وَخَلَقْنَـٰكُمْ","ve haleknakum"],["أَزْوَٰجًۭا","ezvacen"]]},{"v":9,"cuz":30,"sayfa":582,"ar":"وَجَعَلْنَا نَوْمَكُمْ سُبَاتاًۙ","ok":"Ve cealna nevmekum subata.","k":[["وَجَعَلْنَا","ve cealna"],["نَوْمَكُمْ","nevmekum"],["سُبَاتًۭا","subaten"]]},{"v":10,"cuz":30,"sayfa":582,"ar":"وَجَعَلْنَا الَّيْلَ لِبَاساًۙ","ok":"Ve cealnel leyle libasa.","k":[["وَجَعَلْنَا","ve cealna"],["ٱلَّيْلَ","l-leyle"],["لِبَاسًۭا","libasen"]]},{"v":11,"cuz":30,"sayfa":582,"ar":"وَجَعَلْنَا النَّهَارَ مَعَاشاًۖ","ok":"Ve cealnen nehare meaşa.","k":[["وَجَعَلْنَا","ve cealna"],["ٱلنَّهَارَ","n-nehara"],["مَعَاشًۭا","meaaşen"]]},{"v":12,"cuz":30,"sayfa":582,"ar":"وَبَنَيْنَا فَوْقَـكُمْ سَبْعاً شِدَاداًۙ","ok":"Ve beneyna