k":"İnne cehenneme kanet mirsada.","k":[["إِنَّ","inne"],["جَهَنَّمَ","cehenneme"],["كَانَتْ","kanet"],["مِرْصَادًۭا","mirsaden"]]},{"v":22,"cuz":30,"sayfa":582,"ar":"لِلطَّاغ۪ينَ مَاٰباًۙ","ok":"Lit tagine meaba.","k":[["لِّلطَّـٰغِينَ","littagine"],["مَـَٔابًۭا","maben"]]},{"v":23,"cuz":30,"sayfa":582,"ar":"لَابِث۪ينَ ف۪يهَٓا اَحْقَاباًۚ","ok":"Labisine fiha ahkaba.","k":[["لَّـٰبِثِينَ","labisine"],["فِيهَآ","fiha"],["أَحْقَابًۭا","ehkaben"]]},{"v":24,"cuz":30,"sayfa":582,"ar":"لَا يَذُوقُونَ ف۪يهَا بَرْداً وَلَا شَرَاباًۙ","ok":"La yezukune fiha berden ve la şeraba.","k":[["لَّا","la"],["يَذُوقُونَ","yezukune"],["فِيهَا","fiha"],["بَرْدًۭا","berden"],["وَلَا","ve la"],["شَرَابًا","şeraben"]]},{"v":25,"cuz":30,"sayfa":582,"ar":"اِلَّا حَم۪يماً وَغَسَّاقاًۙ","ok":"İlla hamimen ve gassaka.","k":[["إِلَّا","illa"],["حَمِيمًۭا","hamimen"],["وَغَسَّاقًۭا","ve gassakan"]]},{"v":26,"cuz":30,"sayfa":582,"ar":"جَزَٓاءً وِفَاقاً","ok":"Cezaen vifaka.","k":[["جَزَآءًۭ","ceza'en"],["وِفَاقًا","vifakan"]]},{"v":27,"cuz":30,"sayfa":582,"ar":"اِنَّهُمْ كَانُوا لَا يَرْجُونَ حِسَاباًۙ","ok":"İnnehum kanu la yercune hısaba.","k":[["إِنَّهُمْ","innehum"],["كَانُوا۟","kanu"],["لَا","la"],["يَرْجُونَ","yercune"],["حِسَابًۭا","hisaben"]]},{"v":28,"cuz":30,"sayfa":582,"ar":"وَكَذَّبُوا بِاٰيَاتِنَا كِذَّاباًۜ","ok":"Ve kezzebu bi ayatina kizzaba.","k":[["وَكَذَّبُوا۟","ve kezzebu"],["بِـَٔايَـٰتِنَا","biayatina"],["كِذَّابًۭا","kizzaben"]]},{"v":29,"cuz":30,"sayfa":582,"ar":"وَكُلَّ شَيْءٍ اَحْصَيْنَاهُ كِتَاباً","ok":"Ve kulle şey'in ahsaynahu kitaba.","k":[["وَكُلَّ","ve kulle"],["شَىْءٍ","şey'in"],["أَحْصَيْنَـٰهُ","ehsaynahu"],["كِتَـٰبًۭا","kitaben"]]},{"v":30,"cuz":30,"sayfa":582,"ar":"فَذُوقُوا فَلَنْ نَز۪يدَكُمْ اِلَّا عَذَاباً۟","ok":"Fe zuku felen nezidekum illa azaba.","k":[["فَذُوقُوا۟","fezuku"],["فَلَن","fe len"],["نَّزِيدَكُمْ","nezidekum"],["إِلَّا","illa"],["عَذَابًا","azaben"]]},{"v":31,"cuz":30,"sayfa":583,"ar":"اِنَّ لِلْمُتَّق۪ينَ مَفَازاًۙ","ok":"İnne lil mutte