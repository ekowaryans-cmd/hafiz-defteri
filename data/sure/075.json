{"s":75,"ad":"Kıyame","ayetler":[{"v":1,"cuz":29,"sayfa":577,"ar":"لَٓا اُقْسِمُ بِيَوْمِ الْقِيٰمَةِۙ","ok":"La uksimu bi yevmil kıyameh.","k":[["لَآ","la"],["أُقْسِمُ","uksimu"],["بِيَوْمِ","biyevmi"],["ٱلْقِيَـٰمَةِ","l-kiyameti"]]},{"v":2,"cuz":29,"sayfa":577,"ar":"وَلَٓا اُقْسِمُ بِالنَّفْسِ اللَّوَّامَةِ","ok":"Ve la uksimu bin nefsil levvameh.","k":[["وَلَآ","ve la"],["أُقْسِمُ","uksimu"],["بِٱلنَّفْسِ","bin-nefsi"],["ٱللَّوَّامَةِ","l-levvameti"]]},{"v":3,"cuz":29,"sayfa":577,"ar":"اَيَحْسَبُ الْاِنْسَانُ اَلَّنْ نَجْمَعَ عِظَامَهُۜ","ok":"E yahsebul insanu ellen necmea ıza meh.","k":[["أَيَحْسَبُ","eyehsebu"],["ٱلْإِنسَـٰنُ","l-insanu"],["أَلَّن","ellen"],["نَّجْمَعَ","necmea"],["عِظَامَهُۥ","izamehu"]]},{"v":4,"cuz":29,"sayfa":577,"ar":"بَلٰى قَادِر۪ينَ عَلٰٓى اَنْ نُسَوِّيَ بَنَانَهُ","ok":"Bela kadirine ala en nusevviye bena neh.","k":[["بَلَىٰ","bela"],["قَـٰدِرِينَ","kadirine"],["عَلَىٰٓ","ala"],["أَن","en"],["نُّسَوِّىَ","nusevviye"],["بَنَانَهُۥ","benanehu"]]},{"v":5,"cuz":29,"sayfa":577,"ar":"بَلْ يُر۪يدُ الْاِنْسَانُ لِيَفْجُرَ اَمَامَهُۚ","ok":"Bel yuridul insanu li yefcure emameh.","k":[["بَلْ","bel"],["يُرِيدُ","yuridu"],["ٱلْإِنسَـٰنُ","l-insanu"],["لِيَفْجُرَ","liyefcura"],["أَمَامَهُۥ","emamehu"]]},{"v":6,"cuz":29,"sayfa":577,"ar":"يَسْـَٔلُ اَيَّانَ يَوْمُ الْقِيٰمَةِۜ","ok":"Yes'elu eyyane yevmul kıyameh.","k":[["يَسْـَٔلُ","yeselu"],["أَيَّانَ","eyyane"],["يَوْمُ","yevmu"],["ٱلْقِيَـٰمَةِ","l-kiyameti"]]},{"v":7,"cuz":29,"sayfa":577,"ar":"فَاِذَا بَرِقَ الْبَصَرُۙ","ok":"Fe iza berikal basar.","k":[["فَإِذَا","feiza"],["بَرِقَ","berika"],["ٱلْبَصَرُ","l-besaru"]]},{"v":8,"cuz":29,"sayfa":577,"ar":"وَخَسَفَ الْقَمَرُۙ","ok":"Ve hasefel kamer.","k":[["وَخَسَفَ","ve hasefe"],["ٱلْقَمَرُ","l-kameru"]]},{"v":9,"cuz":29,"sayfa":577,"ar":"وَجُمِعَ الشَّمْسُ وَالْقَمَرُۙ","ok":"Ve cumiaş şemsu vel kamer.","k":[["وَجُمِعَ","ve cumia"],["ٱلشَّمْسُ","ş-şemsu"],["وَٱلْقَمَرُ","velkameru"]]},{"v":10,"cuz":29,"sayfa":577,"ar":"يَقُولُ الْاِنْسَانُ يَو