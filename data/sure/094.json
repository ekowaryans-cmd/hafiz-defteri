{"s":94,"ad":"İnşirah","ayetler":[{"v":1,"cuz":30,"sayfa":596,"ar":"اَلَمْ نَشْرَحْ لَكَ صَدْرَكَۙ","ok":"E lem neşrah leke sadrek.","k":[["أَلَمْ","elem"],["نَشْرَحْ","neşrah"],["لَكَ","leke"],["صَدْرَكَ","sadrake"]]},{"v":2,"cuz":30,"sayfa":596,"ar":"وَوَضَعْنَا عَنْكَ وِزْرَكَۙ","ok":"Ve vedagna anke vizrek.","k":[["وَوَضَعْنَا","ve vedea'na"],["عَنكَ","anke"],["وِزْرَكَ","vizrake"]]},{"v":3,"cuz":30,"sayfa":596,"ar":"اَلَّـذ۪ٓي اَنْقَضَ ظَهْرَكَۙ","ok":"Ellezi enkada zahrek.","k":[["ٱلَّذِىٓ","ellezi"],["أَنقَضَ","enkade"],["ظَهْرَكَ","zehrake"]]},{"v":4,"cuz":30,"sayfa":596,"ar":"وَرَفَعْنَا لَكَ ذِكْرَكَۜ","ok":"Ve refa'na leke zikrek.","k":[["وَرَفَعْنَا","ve rafea'na"],["لَكَ","leke"],["ذِكْرَكَ","zikrake"]]},{"v":5,"cuz":30,"sayfa":596,"ar":"فَاِنَّ مَعَ الْعُسْرِ يُسْراًۙ","ok":"Fe inne maal usri yusra.","k":[["فَإِنَّ","feinne"],["مَعَ","mea"],["ٱلْعُسْرِ","l-usri"],["يُسْرًا","yusran"]]},{"v":6,"cuz":30,"sayfa":596,"ar":"اِنَّ مَعَ الْعُسْرِ يُسْراًۜ","ok":"İnne maal usri yusra.","k":[["إِنَّ","inne"],["مَعَ","mea"],["ٱلْعُسْرِ","l-usri"],["يُسْرًۭا","yusran"]]},{"v":7,"cuz":30,"sayfa":596,"ar":"فَاِذَا فَرَغْتَ فَانْصَبْۙ","ok":"Fe iza feragte fensab.","k":[["فَإِذَا","feiza"],["فَرَغْتَ","feragte"],["فَٱنصَبْ","fensab"]]},{"v":8,"cuz":30,"sayfa":596,"ar":"وَاِلٰى رَبِّكَ فَارْغَبْ","ok":"Ve ila rabbike fergab.","k":[["وَإِلَىٰ","ve ila"],["رَبِّكَ","rabbike"],["فَٱرْغَب","fergab"]]}]}