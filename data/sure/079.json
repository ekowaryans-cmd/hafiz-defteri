{"s":79,"ad":"Naziat","ayetler":[{"v":1,"cuz":30,"sayfa":583,"ar":"وَالنَّازِعَاتِ غَرْقاًۙ","ok":"Ven naziati garka.","k":[["وَٱلنَّـٰزِعَـٰتِ","vennaziaati"],["غَرْقًۭا","garkan"]]},{"v":2,"cuz":30,"sayfa":583,"ar":"وَالنَّاشِطَاتِ نَشْطاًۙ","ok":"Ven naşitati neşta.","k":[["وَٱلنَّـٰشِطَـٰتِ","ve nnaşitati"],["نَشْطًۭا","neşten"]]},{"v":3,"cuz":30,"sayfa":583,"ar":"وَالسَّابِحَاتِ سَبْحاًۙ","ok":"Ves sabihati sebha.","k":[["وَٱلسَّـٰبِحَـٰتِ","ve ssabihati"],["سَبْحًۭا","sebhen"]]},{"v":4,"cuz":30,"sayfa":583,"ar":"فَالسَّابِقَاتِ سَبْقاًۙ","ok":"Fes sabikati sebka.","k":[["فَٱلسَّـٰبِقَـٰتِ","fessabikati"],["سَبْقًۭا","sebkan"]]},{"v":5,"cuz":30,"sayfa":583,"ar":"فَالْمُدَبِّرَاتِ اَمْراًۢ","ok":"Fel mudebbirati emra.","k":[["فَٱلْمُدَبِّرَٰتِ","felmudebbirati"],["أَمْرًۭا","emran"]]},{"v":6,"cuz":30,"sayfa":583,"ar":"يَوْمَ تَرْجُفُ الرَّاجِفَةُۙ","ok":"Yevme tercufur racifeh.","k":[["يَوْمَ","yevme"],["تَرْجُفُ","tercufu"],["ٱلرَّاجِفَةُ","r-racifetu"]]},{"v":7,"cuz":30,"sayfa":583,"ar":"تَتْبَعُهَا الرَّادِفَةُۜ","ok":"Tetbeuher radifeh.","k":[["تَتْبَعُهَا","tetbeuha"],["ٱلرَّادِفَةُ","r-radifetu"]]},{"v":8,"cuz":30,"sayfa":583,"ar":"قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌۙ","ok":"Kulubun yevmeizin vacifeh.","k":[["قُلُوبٌۭ","kulubun"],["يَوْمَئِذٍۢ","yevmeizin"],["وَاجِفَةٌ","vacifetun"]]},{"v":9,"cuz":30,"sayfa":583,"ar":"اَبْصَارُهَا خَاشِعَةٌۢ","ok":"Ebsaruha haşiah.","k":[["أَبْصَـٰرُهَا","ebsaruha"],["خَـٰشِعَةٌۭ","haşiatun"]]},{"v":10,"cuz":30,"sayfa":583,"ar":"يَقُولُونَ ءَاِنَّا لَمَرْدُودُونَ فِي الْحَافِرَةِۜ","ok":"Yekulune e inna le merdudune fil hafireh.","k":[["يَقُولُونَ","yekulune"],["أَءِنَّا","einna"],["لَمَرْدُودُونَ","lemerdudune"],["فِى","fi"],["ٱلْحَافِرَةِ","l-hafirati"]]},{"v":11,"cuz":30,"sayfa":583,"ar":"ءَاِذَا كُنَّا عِظَاماً نَخِرَةًۜ","ok":"E iza kunna izamen nahıreh.","k":[["أَءِذَا","eiza"],["كُنَّا","kunna"],["عِظَـٰمًۭا","izamen"],["نَّخِرَةًۭ","nehiraten"]]},{"v":12,"cuz":30,"sayfa":583,"ar":"قَالُوا تِلْكَ اِذاً كَرَّةٌ خَاسِرَةٌۢ",