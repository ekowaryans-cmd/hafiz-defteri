{"s":81,"ad":"Tekvir","ayetler":[{"v":1,"cuz":30,"sayfa":586,"ar":"اِذَا الشَّمْسُ كُـوِّرَتْۙۖ","ok":"İzeş şemsu kuvviret.","k":[["إِذَا","iza"],["ٱلشَّمْسُ","ş-şemsu"],["كُوِّرَتْ","kuvvirat"]]},{"v":2,"cuz":30,"sayfa":586,"ar":"وَاِذَا النُّجُومُ انْكَدَرَتْۙۖ","ok":"Ve izen nucumun kederet.","k":[["وَإِذَا","ve iza"],["ٱلنُّجُومُ","n-nucumu"],["ٱنكَدَرَتْ","nkederat"]]},{"v":3,"cuz":30,"sayfa":586,"ar":"وَاِذَا الْجِبَالُ سُيِّرَتْۙۖ","ok":"Ve izelcibalu suyyiret.","k":[["وَإِذَا","ve iza"],["ٱلْجِبَالُ","l-cibalu"],["سُيِّرَتْ","suyyirat"]]},{"v":4,"cuz":30,"sayfa":586,"ar":"وَاِذَا الْعِشَارُ عُطِّلَتْۙۖ","ok":"Ve izel ışaru uttılet.","k":[["وَإِذَا","ve iza"],["ٱلْعِشَارُ","l-işaru"],["عُطِّلَتْ","uttilet"]]},{"v":5,"cuz":30,"sayfa":586,"ar":"وَاِذَا الْوُحُوشُ حُشِرَتْۙۖ","ok":"Ve izel vuhuşu huşiret.","k":[["وَإِذَا","ve iza"],["ٱلْوُحُوشُ","l-vuhuşu"],["حُشِرَتْ","huşirat"]]},{"v":6,"cuz":30,"sayfa":586,"ar":"وَاِذَا الْبِحَارُ سُجِّرَتْۙۖ","ok":"Ve izel biharu succiret.","k":[["وَإِذَا","ve iza"],["ٱلْبِحَارُ","l-biharu"],["سُجِّرَتْ","succirat"]]},{"v":7,"cuz":30,"sayfa":586,"ar":"وَاِذَا النُّفُوسُ زُوِّجَتْۙۖ","ok":"Ve izen nufusu zuvvicet.","k":[["وَإِذَا","ve iza"],["ٱلنُّفُوسُ","n-nufusu"],["زُوِّجَتْ","zuvvicet"]]},{"v":8,"cuz":30,"sayfa":586,"ar":"وَاِذَا الْمَوْءُ۫دَةُ سُئِلَتْۙ","ok":"Ve izel mev'udetu suilet.","k":[["وَإِذَا","ve iza"],["ٱلْمَوْءُۥدَةُ","l-mev'udetu"],["سُئِلَتْ","suilet"]]},{"v":9,"cuz":30,"sayfa":586,"ar":"بِاَيِّ ذَنْبٍ قُتِلَتْۚ","ok":"Bi eyyi zenbin kutilet.","k":[["بِأَىِّ","bieyyi"],["ذَنۢبٍۢ","zenbin"],["قُتِلَتْ","kutilet"]]},{"v":10,"cuz":30,"sayfa":586,"ar":"وَاِذَا الصُّحُفُ نُشِرَتْۙۖ","ok":"Ve izes suhufu nuşiret.","k":[["وَإِذَا","ve iza"],["ٱلصُّحُفُ","s-suhufu"],["نُشِرَتْ","nuşirat"]]},{"v":11,"cuz":30,"sayfa":586,"ar":"وَاِذَا السَّمَٓاءُ كُشِطَتْۙۖ","ok":"Ve izes semau kuşitat.","k":[["وَإِذَا","ve iza"],["ٱلسَّمَآءُ","s-semau"],["كُشِطَتْ","kuşitat"]]},{"v":12,"cuz":30,"sayfa":586,"ar":"وَاِذَا الْجَح۪يمُ 