{"s":93,"ad":"Duha","ayetler":[{"v":1,"cuz":30,"sayfa":596,"ar":"وَالضُّحٰىۙ","ok":"Ved duha.","k":[["وَٱلضُّحَىٰ","vedduha"]]},{"v":2,"cuz":30,"sayfa":596,"ar":"وَالَّيْلِ اِذَا سَجٰىۙ","ok":"Vel leyli iza seca.","k":[["وَٱلَّيْلِ","velleyli"],["إِذَا","iza"],["سَجَىٰ","seca"]]},{"v":3,"cuz":30,"sayfa":596,"ar":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلٰىۜ","ok":"Ma veddeake rabbuke ve ma kala.","k":[["مَا","ma"],["وَدَّعَكَ","veddeake"],["رَبُّكَ","rabbuke"],["وَمَا","ve ma"],["قَلَىٰ","kala"]]},{"v":4,"cuz":30,"sayfa":596,"ar":"وَلَلْاٰخِرَةُ خَيْرٌ لَكَ مِنَ الْاُو۫لٰىۜ","ok":"Ve lel ahıretu hayrun leke minel ula.","k":[["وَلَلْـَٔاخِرَةُ","velelahiratu"],["خَيْرٌۭ","hayrun"],["لَّكَ","leke"],["مِنَ","mine"],["ٱلْأُولَىٰ","l-ula"]]},{"v":5,"cuz":30,"sayfa":596,"ar":"وَلَسَوْفَ يُعْط۪يكَ رَبُّكَ فَتَـرْضٰىۜ","ok":"Ve le sevfe yu'tike rabbuke fe terda.","k":[["وَلَسَوْفَ","velesevfe"],["يُعْطِيكَ","yua'tike"],["رَبُّكَ","rabbuke"],["فَتَرْضَىٰٓ","feterda"]]},{"v":6,"cuz":30,"sayfa":596,"ar":"اَلَمْ يَجِدْكَ يَت۪ـيـماً فَاٰوٰىۖ","ok":"E lem yecidke yetimen fe ava.","k":[["أَلَمْ","elem"],["يَجِدْكَ","yecidke"],["يَتِيمًۭا","yetimen"],["فَـَٔاوَىٰ","fe ava"]]},{"v":7,"cuz":30,"sayfa":596,"ar":"وَوَجَدَكَ ضَٓالاًّ فَهَدٰىۖ","ok":"Ve vecedeke dallen fe heda.","k":[["وَوَجَدَكَ","ve vecedeke"],["ضَآلًّۭا","dallen"],["فَهَدَىٰ","feheda"]]},{"v":8,"cuz":30,"sayfa":596,"ar":"وَوَجَدَكَ عَٓائِلاً فَاَغْنٰىۜ","ok":"Ve vecedeke ailen fe agna.","k":[["وَوَجَدَكَ","ve vecedeke"],["عَآئِلًۭا","aailen"],["فَأَغْنَىٰ","feegna"]]},{"v":9,"cuz":30,"sayfa":596,"ar":"فَاَمَّا الْيَت۪يمَ فَلَا تَقْهَرْۜ","ok":"Fe emmel yetime fe la takher.","k":[["فَأَمَّا","feemma"],["ٱلْيَتِيمَ","l-yetime"],["فَلَا","fela"],["تَقْهَرْ","tekher"]]},{"v":10,"cuz":30,"sayfa":596,"ar":"وَاَمَّا السَّٓائِلَ فَلَا تَنْهَرْۜ","ok":"Ve emmes saile fe la tenher.","k":[["وَأَمَّا","ve emma"],["ٱلسَّآئِلَ","s-saile"],["فَلَا","fela"],["تَنْهَرْ","tenher"]]},{"v":11,"cuz":30,"sayfa":596,"ar":"وَاَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","ok":"Ve emma bi ni'meti rabbike fe haddis.","k":[["وَأَمَّا","veemma"],["بِنِعْمَةِ","binia'meti"],["رَبِّكَ","rabbike"],["فَحَدِّثْ","fehaddis"]]}]}