{"s":105,"ad":"Fil","ayetler":[{"v":1,"cuz":30,"sayfa":601,"ar":"اَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِاَصْحَابِ الْف۪يلِۜ","ok":"E lem tere keyfe feale rabbuke bi ashabil fil.","k":[["أَلَمْ","elem"],["تَرَ","tera"],["كَيْفَ","keyfe"],["فَعَلَ","feale"],["رَبُّكَ","rabbuke"],["بِأَصْحَـٰبِ","bieshabi"],["ٱلْفِيلِ","l-fili"]]},{"v":2,"cuz":30,"sayfa":601,"ar":"اَلَمْ يَجْعَلْ كَيْدَهُمْ ف۪ي تَضْل۪يلٍۙ","ok":"E lem yec'al keydehum fi tadlil.","k":[["أَلَمْ","elem"],["يَجْعَلْ","yec'al"],["كَيْدَهُمْ","keydehum"],["فِى","fi"],["تَضْلِيلٍۢ","tedlilin"]]},{"v":3,"cuz":30,"sayfa":601,"ar":"وَاَرْسَلَ عَلَيْهِمْ طَيْراً اَبَاب۪يلَۙ","ok":"Ve ersele aleyhim tayren ebabil.","k":[["وَأَرْسَلَ","ve ersele"],["عَلَيْهِمْ","aleyhim"],["طَيْرًا","tayran"],["أَبَابِيلَ","ebabile"]]},{"v":4,"cuz":30,"sayfa":601,"ar":"تَرْم۪يهِمْ بِحِجَارَةٍ مِنْ سِجّ۪يلٍۖۙ","ok":"Termihim bi hicaretin min siccil.","k":[["تَرْمِيهِم","termihim"],["بِحِجَارَةٍۢ","bihicaratin"],["مِّن","min"],["سِجِّيلٍۢ","siccilin"]]},{"v":5,"cuz":30,"sayfa":601,"ar":"فَجَعَلَهُمْ كَعَصْفٍ مَأْكُولٍ","ok":"Fe cealehum keasfin me'kul.","k":[["فَجَعَلَهُمْ","fecealehum"],["كَعَصْفٍۢ","keasfin"],["مَّأْكُولٍۭ","me'kulin"]]}]}