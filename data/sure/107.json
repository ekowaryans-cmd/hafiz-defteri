{"s":107,"ad":"Maun","ayetler":[{"v":1,"cuz":30,"sayfa":602,"ar":"اَرَاَيْتَ الَّذ۪ي يُكَذِّبُ بِالدّ۪ينِۜ","ok":"E raeytellezi yukezzibu bid din.","k":[["أَرَءَيْتَ","eraeyte"],["ٱلَّذِى","llezi"],["يُكَذِّبُ","yukezzibu"],["بِٱلدِّينِ","bid-dini"]]},{"v":2,"cuz":30,"sayfa":602,"ar":"فَذٰلِكَ الَّذ۪ي يَدُعُّ الْيَت۪يمَۙ","ok":"Fe zalikellezi yedu'ul yetim.","k":[["فَذَٰلِكَ","fezalike"],["ٱلَّذِى","llezi"],["يَدُعُّ","yeduau"],["ٱلْيَتِيمَ","l-yetime"]]},{"v":3,"cuz":30,"sayfa":602,"ar":"وَلَا يَحُضُّ عَلٰى طَعَامِ الْمِسْك۪ينِۜ","ok":"Ve la yahuddu ala taamil miskin.","k":[["وَلَا","ve la"],["يَحُضُّ","yehuddu"],["عَلَىٰ","ala"],["طَعَامِ","taaami"],["ٱلْمِسْكِينِ","l-miskini"]]},{"v":4,"cuz":30,"sayfa":602,"ar":"فَوَيْلٌ لِلْمُصَلّ۪ينَۙ","ok":"Fe veylun lil musallin.","k":[["فَوَيْلٌۭ","feveylun"],["لِّلْمُصَلِّينَ","lilmusalline"]]},{"v":5,"cuz":30,"sayfa":602,"ar":"اَلَّذ۪ينَ هُمْ عَنْ صَلَاتِهِمْ سَاهُونَۙ","ok":"Ellezine hum an salatihim sahun.","k":[["ٱلَّذِينَ","ellezine"],["هُمْ","hum"],["عَن","an"],["صَلَاتِهِمْ","salatihim"],["سَاهُونَ","sahune"]]},{"v":6,"cuz":30,"sayfa":602,"ar":"اَلَّذ۪ينَ هُمْ يُرَٓاؤُ۫نَۙ","ok":"Ellezine hum yuraun.","k":[["ٱلَّذِينَ","ellezine"],["هُمْ","hum"],["يُرَآءُونَ","yura'une"]]},{"v":7,"cuz":30,"sayfa":602,"ar":"وَيَمْنَعُونَ الْمَاعُونَ","ok":"Ve yemneunel maun.","k":[["وَيَمْنَعُونَ","ve yemneune"],["ٱلْمَاعُونَ","l-maune"]]}]}