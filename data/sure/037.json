{"s":37,"ad":"Saffat","ayetler":[{"v":1,"cuz":23,"sayfa":446,"ar":"وَالصَّٓافَّاتِ صَفاًّۙ","ok":"Ves saffati saffa.","k":[["وَٱلصَّـٰٓفَّـٰتِ","vessaffati"],["صَفًّۭا","saffen"]]},{"v":2,"cuz":23,"sayfa":446,"ar":"فَالزَّاجِرَاتِ زَجْراًۙ","ok":"Fez zacirati zecra.","k":[["فَٱلزَّٰجِرَٰتِ","fezzacirati"],["زَجْرًۭا","zecran"]]},{"v":3,"cuz":23,"sayfa":446,"ar":"فَالتَّالِيَاتِ ذِكْراًۙ","ok":"Fet taliyati zikra.","k":[["فَٱلتَّـٰلِيَـٰتِ","fettaliyati"],["ذِكْرًا","zikran"]]},{"v":4,"cuz":23,"sayfa":446,"ar":"اِنَّ اِلٰهَكُمْ لَوَاحِدٌۜ","ok":"İnne ilahekum le vahıd.","k":[["إِنَّ","inne"],["إِلَـٰهَكُمْ","ilahekum"],["لَوَٰحِدٌۭ","levahidun"]]},{"v":5,"cuz":23,"sayfa":446,"ar":"رَبُّ السَّمٰوَاتِ وَالْاَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ الْمَشَارِقِۜ","ok":"Rabbus semavati vel ardı ve ma beynehuma ve rabbul meşarık.","k":[["رَّبُّ","rabbu"],["ٱلسَّمَـٰوَٰتِ","s-semavati"],["وَٱلْأَرْضِ","vel'erdi"],["وَمَا","ve ma"],["بَيْنَهُمَا","beynehuma"],["وَرَبُّ","ve rabbu"],["ٱلْمَشَـٰرِقِ","l-meşariki"]]},{"v":6,"cuz":23,"sayfa":446,"ar":"اِنَّا زَيَّنَّا السَّمَٓاءَ الدُّنْيَا بِز۪ينَةٍۨ الْـكَوَاكِبِۙ","ok":"İnna zeyyennes semaed dunya bi ziynetinil kevakib.","k":[["إِنَّا","inna"],["زَيَّنَّا","zeyyenna"],["ٱلسَّمَآءَ","s-semae"],["ٱلدُّنْيَا","d-dunya"],["بِزِينَةٍ","bizinetin"],["ٱلْكَوَاكِبِ","l-kevakibi"]]},{"v":7,"cuz":23,"sayfa":446,"ar":"وَحِفْظاً مِنْ كُلِّ شَيْطَانٍ مَارِدٍۚ","ok":"Ve hıfzan min kulli şeytanin marid.","k":[["وَحِفْظًۭا","ve hifzen"],["مِّن","min"],["كُلِّ","kulli"],["شَيْطَـٰنٍۢ","şeytanin"],["مَّارِدٍۢ","maridin"]]},{"v":8,"cuz":23,"sayfa":446,"ar":"لَا يَسَّمَّعُونَ اِلَى الْمَلَأِ الْاَعْلٰى وَيُقْذَفُونَ مِنْ كُلِّ جَانِبٍۗ","ok":"La yessemmeune ilel meleil a'la ve yukzefune minkulli canib.","k":[["لَّا","la"],["يَسَّمَّعُونَ","yessemmeune"],["إِلَى","ila"],["ٱلْمَلَإِ","l-melei"],["ٱلْأَعْلَىٰ","l-ea'la"],["وَيُقْذَفُونَ","veyukzefune"],["مِن","min"],["كُلِّ","kulli"],["جَانِبٍۢ","canibin"]]},{"v":9,"cuz":23,"sayfa":446,"ar":"دُحُوراً وَلَ