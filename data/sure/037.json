"eiza"],["مِتْنَا","mitna"],["وَكُنَّا","ve kunna"],["تُرَابًۭا","turaben"],["وَعِظَـٰمًا","ve izamen"],["أَءِنَّا","einna"],["لَمَبْعُوثُونَ","lemeb'usune"]]},{"v":17,"cuz":23,"sayfa":446,"ar":"اَوَاٰبَٓاؤُ۬نَا الْاَوَّلُونَۜ","ok":"E ve abaunel evvelun.","k":[["أَوَءَابَآؤُنَا","evaba'una"],["ٱلْأَوَّلُونَ","l-evvelune"]]},{"v":18,"cuz":23,"sayfa":446,"ar":"قُلْ نَعَمْ وَاَنْتُمْ دَاخِرُونَۚ","ok":"Kul neam ve entum dahırun.","k":[["قُلْ","kul"],["نَعَمْ","neam"],["وَأَنتُمْ","ve entum"],["دَٰخِرُونَ","dahirune"]]},{"v":19,"cuz":23,"sayfa":446,"ar":"فَاِنَّمَا هِيَ زَجْرَةٌ وَاحِدَةٌ فَاِذَا هُمْ يَنْظُرُونَ","ok":"Fe innema hiye zecretun vahıdetun fe iza hum yenzurun.","k":[["فَإِنَّمَا","feinnema"],["هِىَ","hiye"],["زَجْرَةٌۭ","zecratun"],["وَٰحِدَةٌۭ","vahidetun"],["فَإِذَا","feiza"],["هُمْ","hum"],["يَنظُرُونَ","yenzurune"]]},{"v":20,"cuz":23,"sayfa":446,"ar":"وَقَالُوا يَا وَيْلَنَا هٰذَا يَوْمُ الدّ۪ينِ","ok":"Ve kalu ya veylena haza yevmud din.","k":[["وَقَالُوا۟","ve kalu"],["يَـٰوَيْلَنَا","ya veylena"],["هَـٰذَا","haza"],["يَوْمُ","yevmu"],["ٱلدِّينِ","d-dini"]]},{"v":21,"cuz":23,"sayfa":446,"ar":"هٰذَا يَوْمُ الْفَصْلِ الَّذ۪ي كُنْتُمْ بِه۪ تُكَذِّبُونَ۟","ok":"Haza yevmul faslillezi kuntum bihi tukezzibun.","k":[["هَـٰذَا","haza"],["يَوْمُ","yevmu"],["ٱلْفَصْلِ","l-fesli"],["ٱلَّذِى","llezi"],["كُنتُم","kuntum"],["بِهِۦ","bihi"],["تُكَذِّبُونَ","tukezzibune"]]},{"v":22,"cuz":23,"sayfa":446,"ar":"اُحْشُرُوا الَّذ۪ينَ ظَلَمُوا وَاَزْوَاجَهُمْ وَمَا كَانُوا يَعْبُدُونَۙ","ok":"Uhşurullezine zalemu ve ezvacehum ve ma kanu ya'budun.","k":[["ٱحْشُرُوا۟","ahşuru"],["ٱلَّذِينَ","ellezine"],["ظَلَمُوا۟","zelemu"],["وَأَزْوَٰجَهُمْ","ve ezvacehum"],["وَمَا","ve ma"],["كَانُوا۟","kanu"],["يَعْبُدُونَ","yea'budune"]]},{"v":23,"cuz":23,"sayfa":446,"ar":"مِنْ دُونِ اللّٰهِ فَاهْدُوهُمْ اِلٰى صِرَاطِ الْجَح۪يمِۙ","ok":"Min dunillahi fehduhum ila sıratıl cahim.","k":[["مِن","min"],["دُونِ","duni"],["ٱللَّهِ","llahi"],["فَٱهْدُوهُمْ","fehduhum"],["إِلَىٰ","ila"],["صِر