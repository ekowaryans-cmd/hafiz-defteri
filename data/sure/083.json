{"s":83,"ad":"Mutaffifin","ayetler":[{"v":1,"cuz":30,"sayfa":587,"ar":"وَيْلٌ لِلْمُطَفِّف۪ينَۙ","ok":"Veylun lil mutaffifin.","k":[["وَيْلٌۭ","veylun"],["لِّلْمُطَفِّفِينَ","lilmutaffifine"]]},{"v":2,"cuz":30,"sayfa":587,"ar":"اَلَّذ۪ينَ اِذَا ا‌كْتَالُوا عَلَى النَّاسِ يَسْتَوْفُونَۘ","ok":"Ellezine izektalu alen nasi yestevfun.","k":[["ٱلَّذِينَ","ellezine"],["إِذَا","iza"],["ٱكْتَالُوا۟","ktalu"],["عَلَى","ala"],["ٱلنَّاسِ","n-nasi"],["يَسْتَوْفُونَ","yestevfune"]]},{"v":3,"cuz":30,"sayfa":587,"ar":"وَاِذَا كَالُوهُمْ اَوْ وَزَنُوهُمْ يُخْسِرُونَۜ","ok":"Ve iza kaluhum ev vezenuhum yuhsirun.","k":[["وَإِذَا","veiza"],["كَالُوهُمْ","kaluhum"],["أَو","ev"],["وَّزَنُوهُمْ","vezenuhum"],["يُخْسِرُونَ","yuhsirune"]]},{"v":4,"cuz":30,"sayfa":587,"ar":"اَلَا يَظُنُّ اُو۬لٰٓئِكَ اَنَّهُمْ مَبْعُوثُونَۙ","ok":"Ela yezunnu ulaike ennehum meb'usun.","k":[["أَلَا","ela"],["يَظُنُّ","yezunnu"],["أُو۟لَـٰٓئِكَ","ulaike"],["أَنَّهُم","ennehum"],["مَّبْعُوثُونَ","meb'usune"]]},{"v":5,"cuz":30,"sayfa":587,"ar":"لِيَوْمٍ عَظ۪يمٍۙ","ok":"Li yevmin azim.","k":[["لِيَوْمٍ","liyevmin"],["عَظِيمٍۢ","azimin"]]},{"v":6,"cuz":30,"sayfa":587,"ar":"يَوْمَ يَقُومُ النَّاسُ لِرَبِّ الْعَالَم۪ينَۜ","ok":"Yevme yekumun nasu li rabbil alemin.","k":[["يَوْمَ","yevme"],["يَقُومُ","yekumu"],["ٱلنَّاسُ","n-nasu"],["لِرَبِّ","lirabbi"],["ٱلْعَـٰلَمِينَ","l-aalemine"]]},{"v":7,"cuz":30,"sayfa":588,"ar":"كَلَّٓا اِنَّ كِتَابَ الْفُجَّارِ لَف۪ي سِجّ۪ينٍۜ","ok":"Kella inne kitabel fuccari le fi siccin.","k":[["كَلَّآ","kella"],["إِنَّ","inne"],["كِتَـٰبَ","kitabe"],["ٱلْفُجَّارِ","l-fuccari"],["لَفِى","lefi"],["سِجِّينٍۢ","siccinin"]]},{"v":8,"cuz":30,"sayfa":588,"ar":"وَمَٓا اَدْرٰيكَ مَا سِجّ۪ينٌۜ","ok":"Ve ma edrake ma siccin.","k":[["وَمَآ","ve ma"],["أَدْرَىٰكَ","edrake"],["مَا","ma"],["سِجِّينٌۭ","siccinun"]]},{"v":9,"cuz":30,"sayfa":588,"ar":"كِتَابٌ مَرْقُومٌۜ","ok":"Kitabun merkum.","k":[["كِتَـٰبٌۭ","kitabun"],["مَّرْقُومٌۭ","merkumun"]]},{"v":10,"cuz":30,"sayfa":588,"ar":"وَيْلٌ يَوْمَئِذٍ 