{"s":82,"ad":"İnfitar","ayetler":[{"v":1,"cuz":30,"sayfa":587,"ar":"اِذَا السَّمَٓاءُ انْفَطَرَتْۙ","ok":"İzes semaunfetaret.","k":[["إِذَا","iza"],["ٱلسَّمَآءُ","s-semau"],["ٱنفَطَرَتْ","nfetarat"]]},{"v":2,"cuz":30,"sayfa":587,"ar":"وَاِذَا الْـكَوَاكِبُ انْتَثَرَتْۙ","ok":"Ve izel kevakibunteseret.","k":[["وَإِذَا","ve iza"],["ٱلْكَوَاكِبُ","l-kevakibu"],["ٱنتَثَرَتْ","nteserat"]]},{"v":3,"cuz":30,"sayfa":587,"ar":"وَاِذَا الْبِحَارُ فُجِّرَتْۙ","ok":"Ve izel biharu fucciret.","k":[["وَإِذَا","ve iza"],["ٱلْبِحَارُ","l-biharu"],["فُجِّرَتْ","fuccirat"]]},{"v":4,"cuz":30,"sayfa":587,"ar":"وَاِذَا الْقُبُورُ بُعْثِرَتْۙ","ok":"Ve izel kuburu bu'siret.","k":[["وَإِذَا","ve iza"],["ٱلْقُبُورُ","l-kuburu"],["بُعْثِرَتْ","bua'sirat"]]},{"v":5,"cuz":30,"sayfa":587,"ar":"عَلِمَتْ نَفْسٌ مَا قَدَّمَتْ وَاَخَّرَتْۜ","ok":"Alimet nefsun ma kaddemet ve ahharet.","k":[["عَلِمَتْ","alimet"],["نَفْسٌۭ","nefsun"],["مَّا","ma"],["قَدَّمَتْ","kaddemet"],["وَأَخَّرَتْ","ve ehharat"]]},{"v":6,"cuz":30,"sayfa":587,"ar":"يَٓا اَيُّهَا الْاِنْسَانُ مَا غَرَّكَ بِرَبِّكَ الْـكَر۪يمِۙ","ok":"Ya eyyuhel insanu ma garreke bi rabbikel kerim.","k":[["يَـٰٓأَيُّهَا","ya eyyuha"],["ٱلْإِنسَـٰنُ","l-insanu"],["مَا","ma"],["غَرَّكَ","garrake"],["بِرَبِّكَ","birabbike"],["ٱلْكَرِيمِ","l-kerimi"]]},{"v":7,"cuz":30,"sayfa":587,"ar":"اَلَّذ۪ي خَلَقَكَ فَسَوّٰيكَ فَعَدَلَكَۙ","ok":"Ellezi halakake fe sevvake fe adelek.","k":[["ٱلَّذِى","ellezi"],["خَلَقَكَ","halekake"],["فَسَوَّىٰكَ","fesevvake"],["فَعَدَلَكَ","feadeleke"]]},{"v":8,"cuz":30,"sayfa":587,"ar":"ف۪ٓي اَيِّ صُورَةٍ مَا شَٓاءَ رَكَّبَكَۜ","ok":"Fi eyyi suretin ma şae rekkebek.","k":[["فِىٓ","fi"],["أَىِّ","eyyi"],["صُورَةٍۢ","suratin"],["مَّا","ma"],["شَآءَ","şa'e"],["رَكَّبَكَ","rakkebeke"]]},{"v":9,"cuz":30,"sayfa":587,"ar":"كَلَّا بَلْ تُكَذِّبُونَ بِالدّ۪ينِۙ","ok":"Kella bel tukezzibune bid din.","k":[["كَلَّا","kella"],["بَلْ","bel"],["تُكَذِّبُونَ","tukezzibune"],["بِٱلدِّينِ","bid-dini"]]},{"v":10,"cuz":30,"sayfa":587,"ar":"وَاِنَّ عَلَيْكُمْ لَحَافِظ۪ينَۙ","ok":"Ve inne aleykum le hafızin.","k":[["وَإِنَّ","ve inne"],["عَلَيْكُمْ","aleykum"],["لَحَـٰفِظِينَ","lehafizine"]]},{"v":11,"cuz":30,"sayfa":587,"ar":"كِرَاماً كَاتِب۪ينَۙ","ok":"Kiramen katibin.","k":[["كِرَامًۭا","kiramen"],["كَـٰتِبِينَ","katibine"]]},{"v":12,"cuz":30,"sayfa":587,"ar":"يَعْلَمُونَ مَا تَفْعَلُونَ","ok":"Ya'lemune ma tef'alun.","k":[["يَعْلَمُونَ","yea'lemune"],["مَا","ma"],["تَفْعَلُونَ","tef'alune"]]},{"v":13,"cuz":30,"sayfa":587,"ar":"اِنَّ الْاَبْرَارَ لَف۪ي نَع۪يمٍۚ","ok":"İnnel ebrare lefi naim.","k":[["إِنَّ","inne"],["ٱلْأَبْرَارَ","l-ebrara"],["لَفِى","lefi"],["نَعِيمٍۢ","neiymin"]]},{"v":14,"cuz":30,"sayfa":587,"ar":"وَاِنَّ الْفُجَّارَ لَف۪ي جَح۪يمٍۚ","ok":"Ve innel fuccare lefi cahim.","k":[["وَإِنَّ","ve inne"],["ٱلْفُجَّارَ","l-fuccara"],["لَفِى","lefi"],["جَحِيمٍۢ","cehimin"]]},{"v":15,"cuz":30,"sayfa":587,"ar":"يَصْلَوْنَهَا يَوْمَ الدّ۪ينِ","ok":"Yaslevneha yevmed din.","k":[["يَصْلَوْنَهَا","yeslevneha"],["يَوْمَ","yevme"],["ٱلدِّينِ","d-dini"]]},{"v":16,"cuz":30,"sayfa":587,"ar":"وَمَا هُمْ عَنْهَا بِغَٓائِب۪ينَۜ","ok":"Ve ma hum anha bi gaibin.","k":[["وَمَا","ve ma"],["هُمْ","hum"],["عَنْهَا","anha"],["بِغَآئِبِينَ","bigaibine"]]},{"v":17,"cuz":30,"sayfa":587,"ar":"وَمَٓا اَدْرٰيكَ مَا يَوْمُ الدّ۪ينِۙ","ok":"Ve ma edrake ma yevmud din.","k":[["وَمَآ","ve ma"],["أَدْرَىٰكَ","edrake"],["مَا","ma"],["يَوْمُ","yevmu"],["ٱلدِّينِ","d-dini"]]},{"v":18,"cuz":30,"sayfa":587,"ar":"ثُمَّ مَٓا اَدْرٰيكَ مَا يَوْمُ الدّ۪ينِۜ","ok":"Summe ma edrake ma yevmud din.","k":[["ثُمَّ","summe"],["مَآ","ma"],["أَدْرَىٰكَ","edrake"],["مَا","ma"],["يَوْمُ","yevmu"],["ٱلدِّينِ","d-dini"]]},{"v":19,"cuz":30,"sayfa":587,"ar":"يَوْمَ لَا تَمْلِكُ نَفْسٌ لِنَفْسٍ شَيْـٔاًۜ وَالْاَمْرُ يَوْمَئِذٍ لِلّٰهِ","ok":"Yevme la temliku nefsun li nefsin şey'a, vel emru yevmeizin lillah.","k":[["يَوْمَ","yevme"],["لَا","la"],["تَمْلِكُ","temliku"],["نَفْسٌۭ","nefsun"],["لِّنَفْسٍۢ","linefsin"],["شَيْـًۭٔا ۖ","şey'en"],["وَٱلْأَمْرُ","vel'emru"],["يَوْمَئِذٍۢ","yevmeizin"],["لِّلَّهِ","lillahi"]]}]}