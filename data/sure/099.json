{"s":99,"ad":"Zilzal","ayetler":[{"v":1,"cuz":30,"sayfa":599,"ar":"اِذَا زُلْزِلَتِ الْاَرْضُ زِلْزَالَهَاۙ","ok":"İza zulziletil ardu zilzaleha.","k":[["إِذَا","iza"],["زُلْزِلَتِ","zulzileti"],["ٱلْأَرْضُ","l-erdu"],["زِلْزَالَهَا","zilzaleha"]]},{"v":2,"cuz":30,"sayfa":599,"ar":"وَاَخْرَجَتِ الْاَرْضُ اَثْقَالَهَاۙ","ok":"Ve ahrecetil ardu eskaleha.","k":[["وَأَخْرَجَتِ","ve ehraceti"],["ٱلْأَرْضُ","l-erdu"],["أَثْقَالَهَا","eskaleha"]]},{"v":3,"cuz":30,"sayfa":599,"ar":"وَقَالَ الْاِنْسَانُ مَا لَهَاۚ","ok":"Ve kalel insanu ma leha.","k":[["وَقَالَ","ve kale"],["ٱلْإِنسَـٰنُ","l-insanu"],["مَا","ma"],["لَهَا","leha"]]},{"v":4,"cuz":30,"sayfa":599,"ar":"يَوْمَئِذٍ تُحَدِّثُ اَخْبَارَهَاۙ","ok":"Yevme izin tuhaddisu ahbareha.","k":[["يَوْمَئِذٍۢ","yevmeizin"],["تُحَدِّثُ","tuhaddisu"],["أَخْبَارَهَا","ehbaraha"]]},{"v":5,"cuz":30,"sayfa":599,"ar":"بِاَنَّ رَبَّكَ اَوْحٰى لَهَاۜ","ok":"Bi enne rabbeke evhaleha.","k":[["بِأَنَّ","bienne"],["رَبَّكَ","rabbeke"],["أَوْحَىٰ","evha"],["لَهَا","leha"]]},{"v":6,"cuz":30,"sayfa":599,"ar":"يَوْمَئِذٍ يَصْدُرُ النَّاسُ اَشْتَاتاً لِيُرَوْا اَعْمَالَهُمْۜ","ok":"Yevme izin yasdurun nasu eştaten li yurev a'malehum.","k":[["يَوْمَئِذٍۢ","yevmeizin"],["يَصْدُرُ","yesduru"],["ٱلنَّاسُ","n-nasu"],["أَشْتَاتًۭا","eştaten"],["لِّيُرَوْا۟","liyurav"],["أَعْمَـٰلَهُمْ","ea'malehum"]]},{"v":7,"cuz":30,"sayfa":599,"ar":"فَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْراً يَرَهُۜ","ok":"Fe men ya'mel miskale zerretin hayren yereh.","k":[["فَمَن","femen"],["يَعْمَلْ","yea'mel"],["مِثْقَالَ","miskale"],["ذَرَّةٍ","zerratin"],["خَيْرًۭا","hayran"],["يَرَهُۥ","yerahu"]]},{"v":8,"cuz":30,"sayfa":599,"ar":"وَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَراًّ يَرَهُ","ok":"Ve men ya'mel miskale zerretin şerren yereh.","k":[["وَمَن","ve men"],["يَعْمَلْ","yea'mel"],["مِثْقَالَ","miskale"],["ذَرَّةٍۢ","zerratin"],["شَرًّۭا","şerran"],["يَرَهُۥ","yerahu"]]}]}