{"s":97,"ad":"Kadir","ayetler":[{"v":1,"cuz":30,"sayfa":598,"ar":"اِنَّٓا اَنْزَلْنَاهُ ف۪ي لَيْلَةِ الْقَدْرِۚ","ok":"İnna enzelnahu fi leyletil kadr.","k":[["إِنَّآ","inna"],["أَنزَلْنَـٰهُ","enzelnahu"],["فِى","fi"],["لَيْلَةِ","leyleti"],["ٱلْقَدْرِ","l-kadri"]]},{"v":2,"cuz":30,"sayfa":598,"ar":"وَمَٓا اَدْرٰيكَ مَا لَيْلَةُ الْقَدْرِۜ","ok":"Ve ma edrake ma leyletul kadr.","k":[["وَمَآ","ve ma"],["أَدْرَىٰكَ","edrake"],["مَا","ma"],["لَيْلَةُ","leyletu"],["ٱلْقَدْرِ","l-kadri"]]},{"v":3,"cuz":30,"sayfa":598,"ar":"لَيْلَةُ الْقَدْرِ خَيْرٌ مِنْ اَلْفِ شَهْرٍۜ","ok":"Leyletul kadri hayrun min elfi şehr.","k":[["لَيْلَةُ","leyletu"],["ٱلْقَدْرِ","l-kadri"],["خَيْرٌۭ","hayrun"],["مِّنْ","min"],["أَلْفِ","elfi"],["شَهْرٍۢ","şehrin"]]},{"v":4,"cuz":30,"sayfa":598,"ar":"تَنَزَّلُ الْمَلٰٓئِكَةُ وَالرُّوحُ ف۪يهَا بِاِذْنِ رَبِّهِمْۚ مِنْ كُلِّ اَمْرٍۙۛ","ok":"Tenezzelul melaiketu ver ruhu fiha bi izni rabbihim min kulli emrin.","k":[["تَنَزَّلُ","tenezzelu"],["ٱلْمَلَـٰٓئِكَةُ","l-melaiketu"],["وَٱلرُّوحُ","ve rruhu"],["فِيهَا","fiha"],["بِإِذْنِ","biizni"],["رَبِّهِم","rabbihim"],["مِّن","min"],["كُلِّ","kulli"],["أَمْرٍۢ","emrin"]]},{"v":5,"cuz":30,"sayfa":598,"ar":"سَلَامٌ۠ۛ هِيَ حَتّٰى مَطْلَعِ الْفَجْرِ","ok":"Selamun, hiye hatta matlaıl fecr.","k":[["سَلَـٰمٌ","selamun"],["هِىَ","hiye"],["حَتَّىٰ","hatta"],["مَطْلَعِ","metlei"],["ٱلْفَجْرِ","l-fecri"]]}]}