{"s":55,"ad":"Rahman","ayetler":[{"v":1,"cuz":27,"sayfa":531,"ar":"اَلرَّحْمٰنُۙ","ok":"Er rahman.","k":[["ٱلرَّحْمَـٰنُ","er-rahmanu"]]},{"v":2,"cuz":27,"sayfa":531,"ar":"عَلَّمَ الْقُرْاٰنَۜ","ok":"Allemel kur'an.","k":[["عَلَّمَ","alleme"],["ٱلْقُرْءَانَ","l-kurane"]]},{"v":3,"cuz":27,"sayfa":531,"ar":"خَلَقَ الْاِنْسَانَۙ","ok":"Halakal insan.","k":[["خَلَقَ","haleka"],["ٱلْإِنسَـٰنَ","l-insane"]]},{"v":4,"cuz":27,"sayfa":531,"ar":"عَلَّمَهُ الْبَيَانَ","ok":"Allemehul beyan.","k":[["عَلَّمَهُ","allemehu"],["ٱلْبَيَانَ","l-beyane"]]},{"v":5,"cuz":27,"sayfa":531,"ar":"اَلشَّمْسُ وَالْقَمَرُ بِحُسْبَانٍۖ","ok":"Eş şemsu vel kameru bi husban.","k":[["ٱلشَّمْسُ","eş-şemsu"],["وَٱلْقَمَرُ","velkameru"],["بِحُسْبَانٍۢ","bihusbanin"]]},{"v":6,"cuz":27,"sayfa":531,"ar":"وَالنَّجْمُ وَالشَّجَرُ يَسْجُدَانِ","ok":"Ven necmu veş şeceru yescudan.","k":[["وَٱلنَّجْمُ","ve nnecmu"],["وَٱلشَّجَرُ","ve şşeceru"],["يَسْجُدَانِ","yescudani"]]},{"v":7,"cuz":27,"sayfa":531,"ar":"وَالسَّمَٓاءَ رَفَعَهَا وَوَضَعَ الْم۪يزَانَۙ","ok":"Ves semae refeaha ve vedaal mizan.","k":[["وَٱلسَّمَآءَ","ve ssemae"],["رَفَعَهَا","rafeaha"],["وَوَضَعَ","ve vedea"],["ٱلْمِيزَانَ","l-mizane"]]},{"v":8,"cuz":27,"sayfa":531,"ar":"اَلَّا تَطْغَوْا فِي الْم۪يزَانِ","ok":"Ella tatgav fil mizan.","k":[["أَلَّا","ella"],["تَطْغَوْا۟","tetgav"],["فِى","fi"],["ٱلْمِيزَانِ","l-mizani"]]},{"v":9,"cuz":27,"sayfa":531,"ar":"وَاَق۪يمُوا الْوَزْنَ بِالْقِسْطِ وَلَا تُخْسِرُوا الْم۪يزَانَ","ok":"Ve ekimul vezne bil kıstı ve la tuhsırul mizan.","k":[["وَأَقِيمُوا۟","ve ekimu"],["ٱلْوَزْنَ","l-vezne"],["بِٱلْقِسْطِ","bil-kisti"],["وَلَا","ve la"],["تُخْسِرُوا۟","tuhsiru"],["ٱلْمِيزَانَ","l-mizane"]]},{"v":10,"cuz":27,"sayfa":531,"ar":"وَالْاَرْضَ وَضَعَهَا لِلْاَنَامِۙ","ok":"Vel arda vedaaha lil enam.","k":[["وَٱلْأَرْضَ","vel'erde"],["وَضَعَهَا","vedeaha"],["لِلْأَنَامِ","lilenami"]]},{"v":11,"cuz":27,"sayfa":531,"ar":"ف۪يهَا فَاكِهَةٌۖ وَالنَّخْلُ ذَاتُ الْاَكْمَامِ","ok":"Fiha fakihetun vennahlu zatul ekmam.","k":