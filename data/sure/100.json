{"s":100,"ad":"Adiyat","ayetler":[{"v":1,"cuz":30,"sayfa":599,"ar":"وَالْعَـادِيَاتِ ضَبْـحاًۙ","ok":"Vel adiyati dabha.","k":[["وَٱلْعَـٰدِيَـٰتِ","vel'aadiyati"],["ضَبْحًۭا","debhen"]]},{"v":2,"cuz":30,"sayfa":599,"ar":"فَالْمُـورِيَاتِ قَـدْحاًۙ","ok":"Fel muriyati kadha.","k":[["فَٱلْمُورِيَـٰتِ","felmuriyati"],["قَدْحًۭا","kadhen"]]},{"v":3,"cuz":30,"sayfa":599,"ar":"فَالْمُغ۪يرَاتِ صُبْحاًۙ","ok":"Fel mugirati subha.","k":[["فَٱلْمُغِيرَٰتِ","felmugirati"],["صُبْحًۭا","subhen"]]},{"v":4,"cuz":30,"sayfa":599,"ar":"فَاَثَرْنَ بِه۪ نَقْعاًۙ","ok":"Fe eserne bihi nak'a.","k":[["فَأَثَرْنَ","feeserne"],["بِهِۦ","bihi"],["نَقْعًۭا","nek'an"]]},{"v":5,"cuz":30,"sayfa":599,"ar":"فَوَسَطْنَ بِه۪ جَمْعاًۙ","ok":"Fe vesatne bihi cem'a.","k":[["فَوَسَطْنَ","fevesetne"],["بِهِۦ","bihi"],["جَمْعًا","cem'an"]]},{"v":6,"cuz":30,"sayfa":599,"ar":"اِنَّ الْاِنْسَانَ لِرَبِّه۪ لَكَنُودٌۚ","ok":"İnnel insane li rabbihi le kenud.","k":[["إِنَّ","inne"],["ٱلْإِنسَـٰنَ","l-insane"],["لِرَبِّهِۦ","lirabbihi"],["لَكَنُودٌۭ","lekenudun"]]},{"v":7,"cuz":30,"sayfa":599,"ar":"وَاِنَّهُ عَلٰى ذٰلِكَ لَشَه۪يدٌۚ","ok":"Ve innehu ala zalike le şehid.","k":[["وَإِنَّهُۥ","ve innehu"],["عَلَىٰ","ala"],["ذَٰلِكَ","zalike"],["لَشَهِيدٌۭ","leşehidun"]]},{"v":8,"cuz":30,"sayfa":599,"ar":"وَاِنَّهُ لِحُبِّ الْخَيْرِ لَشَد۪يدٌۜ","ok":"Ve innehu li hubbil hayri le şedid.","k":[["وَإِنَّهُۥ","ve innehu"],["لِحُبِّ","lihubbi"],["ٱلْخَيْرِ","l-hayri"],["لَشَدِيدٌ","leşedidun"]]},{"v":9,"cuz":30,"sayfa":599,"ar":"اَفَلَا يَعْلَمُ اِذَا بُعْثِرَ مَا فِي الْقُبُورِۙ","ok":"E fe la ya'lemu iza bu'sirama fil kubur.","k":[["أَفَلَا","efela"],["يَعْلَمُ","yea'lemu"],["إِذَا","iza"],["بُعْثِرَ","bua'sira"],["مَا","ma"],["فِى","fi"],["ٱلْقُبُورِ","l-kuburi"]]},{"v":10,"cuz":30,"sayfa":600,"ar":"وَحُصِّلَ مَا فِي الصُّدُورِۙ","ok":"Ve hussıle ma fis sudur.","k":[["وَحُصِّلَ","ve hussile"],["مَا","ma"],["فِى","fi"],["ٱلصُّدُورِ","s-suduri"]]},{"v":11,"cuz":30,"sayfa":600,"ar":"اِنَّ رَبَّهُمْ بِهِمْ يَوْمَئِذٍ لَخَ